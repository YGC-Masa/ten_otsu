          "opacity": 1
        },
        {
          "id": "ah",
          "src": "images/assets/char/h10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "急がなくていいです"
    },
    {
      "speaker": "美空",
      "text": "一緒に見ていきましょう"
    },
    {
      "speaker": "",
      "text": "店長と夜空は、自然とそちらを見る。"
    },
    {
      "speaker": "",
      "text": "少し離れた場所で、美空が年配のお客様と話していた。"
    },
    {
      "speaker": "",
      "text": "お客様は、少し困ったようにリモコン売り場とテレビ売り場を見比べている。"
    },
    {
      "speaker": "",
      "text": "美空は、急かさず、笑顔で隣に立っていた。"
    },
    {
      "speaker": "お客様",
      "text": "こういうの、どれが合うか分からなくてね"
    },
    {
      "speaker": "美空",
      "text": "分かりづらいですよね"
    },
    {
      "speaker": "美空",
      "text": "テレビの型番、写真で残ってたりしますか？"
    },
    {
      "speaker": "お客様",
      "text": "ああ、あるかもしれない"
    },
    {
      "speaker": "美空",
      "text": "じゃあ、それを一緒に見てみましょう"
    },
    {
      "speaker": "美空",
      "text": "もし分からなかったら、今使っているリモコンの写真でも大丈夫です"
    },
    {
      "speaker": "お客様",
      "text": "そうなの？"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "美空",
      "text": "焦らなくて大丈夫です"
    },
    {
      "speaker": "美空",
      "text": "合うものを探しましょう"
    },
    {
      "speaker": "",
      "text": "お客様の表情が、少しずつ和らいでいく。"
    },
    {
      "speaker": "",
      "text": "最初にあった戸惑いが、美空の声に合わせるように薄れていった。"
    },
    {
      "speaker": "",
      "text": "夜空は、その様子を黙って見ていた。"
    },
    {
      "speaker": "店長",
