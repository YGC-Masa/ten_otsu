    },
    {
      "speaker": "店長",
      "text": "夜空？"
    },
    {
      "speaker": "夜空",
      "text": "美空はすごい"
    },
    {
      "speaker": "店長",
      "text": "お"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "店長",
      "text": "いや"
    },
    {
      "speaker": "夜空",
      "text": "変な反応しないで"
