  "steps": [
    {
      "speaker": "",
      "text": "閉店前の店内。",
      "bg": "images/assets/bg/bg_hidamari_store_salesfloor_night.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "",
      "text": "昼間のにぎわいは落ち着き、売り場には静かな照明が残っていた。"
    },
    {
      "speaker": "",
      "text": "夏物家電コーナーの前で、夜空が棚の位置を調整している。"
    },
    {
      "speaker": "",
      "text": "小さなPOP。"
    },
    {
      "speaker": "",
      "text": "涼しげな色の飾り。"
    },
    {
      "speaker": "",
      "text": "価格札の角度。"
    },
    {
      "speaker": "",
      "text": "手にした小物を置いて、少し離れて、また戻す。"
    },
    {
      "speaker": "",
      "text": "夜空は、何度も売り場全体を見直していた。"
    },
    {
      "speaker": "店長",
      "text": "細かいな"
    },
    {
      "speaker": "夜空",
      "text": "見づらいと意味ないから",
