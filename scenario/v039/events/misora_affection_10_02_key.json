    {
      "speaker": "夜空",
      "text": "いた"
    },
    {
      "speaker": "美空",
      "text": "売り場、すごくきれいになってる"
    },
    {
      "speaker": "美空",
      "text": "やっぱり夜空はすごいね"
    },
    {
      "speaker": "夜空",
      "text": "別に"
    },
    {
      "speaker": "美空",
      "text": "また別にって言った"
    },
    {
      "speaker": "夜空",
      "text": "事実だから"
    },
    {
      "speaker": "店長",
      "text": "夜空も褒めようとしてたぞ"
    },
    {
      "speaker": "夜空",
      "text": "ちょっ……店長！"
    },
    {
      "speaker": "美空",
      "text": "え？"
    },
    {
      "speaker": "店長",
      "text": "美空はすごいって"
    },
    {
      "speaker": "夜空",
      "text": "言ってない"
    },
    {
      "speaker": "店長",
      "text": "言ってた"
    },
    {
      "speaker": "夜空",
      "text": "言ってない"
    },
    {
      "speaker": "美空",
      "text": "夜空が？"
    },
    {
      "speaker": "夜空",
      "text": "……別に"
    },
    {
      "speaker": "",
      "text": "美空は、ぱっと表情を明るくした。"
    },
    {
      "speaker": "美空",
      "text": "嬉しい"
    },
    {
      "speaker": "夜空",
      "text": "まだ何も言ってない"
    },
    {
      "speaker": "美空",
      "text": "でも嬉しい"
    },
    {
      "speaker": "夜空",
      "text": "……勝手にして"
    },
    {
      "speaker": "",
      "text": "夜空は顔をそらす。"
    },
    {
      "speaker": "",
      "text": "その耳が、ほんの少し赤い。"
    },
    {
      "speaker": "美空",
      "text": "夜空に褒められるの、嬉しいな"
    },
    {
      "speaker": "夜空",
      "text": "だから、褒めてない"
    },
    {
      "speaker": "店長",
      "text": "でも、美空はすごいんだろ？"
    },
    {
      "speaker": "夜空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "夜空は答えない。"
    },
    {
      "speaker": "",
      "text": "美空はにこにこしながら、夜空の顔を覗き込む。"
    },
    {
      "speaker": "美空",
      "text": "夜空？"
    },
    {
      "speaker": "夜空",
      "text": "近い"
    },
    {
      "speaker": "美空",
      "text": "言ってくれたら嬉しいです"
    },
    {
      "speaker": "夜空",
      "text": "言わない"
    },
    {
      "speaker": "美空",
      "text": "そっか"
    },
    {
      "speaker": "美空",
      "text": "でも、聞こえた気がするからいいです"
    },
    {
      "speaker": "夜空",
      "text": "聞こえてない"
    },
    {
      "speaker": "美空",
      "text": "心で聞きました"
    },
    {
      "speaker": "夜空",
      "text": "何それ"
    },
    {
      "speaker": "",
      "text": "店長は二人を見て、少し笑う。"
    },
    {
      "speaker": "",
      "text": "美空が確認を終えたリモコンを持って、再びお客様のところへ戻っていく。"
    },
    {
      "speaker": "美空",
