    {
      "speaker": "店長",
      "text": "そうか？"
    },
    {
      "speaker": "夜空",
      "text": "できない"
    },
    {
      "speaker": "夜空",
      "text": "ぼくなら、先に商品を見る"
    },
    {
      "speaker": "夜空",
      "text": "性能、価格、対応機種、在庫"
    },
    {
      "speaker": "夜空",
      "text": "その方が早いから"
    },
    {
      "speaker": "店長",
      "text": "それはそれで助かるけどな"
    },
    {
      "speaker": "夜空",
      "text": "でも、美空は先に人を見る"
    },
    {
      "speaker": "店長",
      "text": "人？"
    },
    {
      "speaker": "夜空",
      "text": "困ってるのか"
    },
    {
      "speaker": "夜空",
      "text": "焦ってるのか"
    },
    {
      "speaker": "夜空",
      "text": "説明を急いでいいのか"
