  "steps": [
    {
      "speaker": "",
      "text": "――ひだまりストア・閉店後の売り場――",
      "bg": "images/assets/bg/bg_hidamari_store_closed_night.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "店長",
      "text": "夜空、今日の売り場整理、かなり見やすくなったな。"
    },
    {
      "speaker": "夜空",
      "text": "……普通。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "普通じゃないと思うぞ。\n加湿器の棚、用途ごとに分けてくれただろ。"
    },
    {
      "speaker": "夜空",
      "text": "寝室用、リビング用、卓上用。\nその方が、お客様が迷いにくいから。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そこが助かるんだよ。"
    },
    {
      "speaker": "夜空",
      "text": "……言わなくていい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "悪い。"
    },
    {
      "speaker": "夜空",
      "text": "……。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "いや、今日は言ってもよかったか？"
    },
    {
      "speaker": "夜空",
      "text": "……どっちでもない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "どっちでもない？"
    },
    {
      "speaker": "夜空",
      "text": "言われると困る。\nでも、言われなかったら、それはそれで……少し気になる。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そっか。"
    },
    {
      "speaker": "夜空",
      "text": "言わなくていい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "――夜空は棚の前に立ち、商品の角度を微調整する。\nすでにきれいに並んでいる商品を、ほんの少しだけ直していた。"
    },
    {
      "speaker": "店長",
      "text": "夜空。"
    },
    {
      "speaker": "夜空",
      "text": "なに。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日は、褒めてもいいか？"
    },
    {
      "speaker": "夜空",
      "text": "……聞かれると余計に恥ずかしい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、聞かずに褒めた方がいい？"
    },
    {
      "speaker": "夜空",
      "text": "それも困る。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しいな。"
    },
    {
      "speaker": "夜空",
      "text": "難しくしてるのは、ぼく。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "最近、それを自分で言うようになったな。"
    },
    {
      "speaker": "夜空",
      "text": "……そういうところを見ないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "悪い。"
    },
    {
      "speaker": "夜空",
      "text": "でも……今日は少しだけならいい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "少しだけ？"
    },
    {
      "speaker": "夜空",
      "text": "うん。\n褒めすぎないで。\n大げさにしないで。\n美空みたいにまっすぐ言いすぎないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "注文が多いな。"
    },
    {
      "speaker": "夜空",
      "text": "練習だから。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "褒められる練習？"
    },
    {
      "speaker": "夜空",
      "text": "……そう。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "わかった。"
    },
    {
      "speaker": "",
      "text": "――店長は少し考えてから、棚を見る。"
    },
    {
      "speaker": "店長",
      "text": "今日の棚、夜空らしくていいと思う。"
    },
    {
      "speaker": "夜空",
      "text": "……。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "見やすい。\n落ち着いてる。\nそれに、お客様が困る前に迷いを減らしてくれてる。"
    },
    {
      "speaker": "夜空",
      "text": "……それ、褒めすぎ。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "少しオーバーだったか？"
    },
    {
      "speaker": "夜空",
      "text": "少し。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、短くする。\n助かった。"
    },
    {
      "speaker": "夜空",
      "text": "……それなら、ぎりぎり。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ぎりぎりか。"
    },
    {
      "speaker": "夜空",
      "text": "うん。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、夜空。\n助かった。"
    },
    {
      "speaker": "夜空",
      "text": "……。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "どうだ？"
    },
    {
      "speaker": "夜空",
      "text": "……逃げたくなる。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "逃げるか？"
    },
    {
      "speaker": "夜空",
      "text": "逃げない。\n練習だから。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "えらいな。"
    },
    {
      "speaker": "夜空",
      "text": "褒めすぎないでって言った。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今のは少しだけだ。"
    },
    {
      "speaker": "夜空",
      "text": "少しでも恥ずかしい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも、逃げなかった。"
    },
    {
      "speaker": "夜空",
      "text": "……うん。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "――夜空は顔をそらす。\n耳は赤いが、その場から離れようとはしなかった。"
    },
    {
      "speaker": "店長",
      "text": "夜空。"
    },
    {
      "speaker": "夜空",
      "text": "なに。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "受け取ってくれてありがとう。"
    },
    {
      "speaker": "夜空",
      "text": "お礼を言うところじゃない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも、受け取ろうとしてくれたから。"
    },
    {
      "speaker": "夜空",
      "text": "……そういうの、本当にずるい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日はずるくてもいいか？"
    },
    {
      "speaker": "夜空",
      "text": "よくない。\nでも……少しだけなら、許す。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ありがとう。"
    },
    {
      "speaker": "夜空",
      "text": "またお礼。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "癖かもしれない。"
    },
    {
      "speaker": "夜空",
      "text": "直して。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "努力する。"
    },
    {
      "speaker": "夜空",
      "text": "信用できない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "――そこへ、美空が奥から戻ってくる。\n手には閉店チェック用のファイルを持っていた。"
    },
    {
      "speaker": "美空",
      "text": "あれ、二人ともまだ売り場にいたんですね。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "美空。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "夜空、顔赤い？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "赤くない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "赤いよ？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "美空まで見ないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ごめん。\nでも、何かあった？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "夜空が褒められる練習をしてた。"
    },
    {
      "speaker": "夜空",
      "text": "店長。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "褒められる練習？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "言わなくていい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "すごい。\n夜空、ちゃんと練習してるんだ。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "すごくない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "すごいよ。\n夜空、褒められるとすぐ逃げちゃってたのに。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "今も逃げたい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "でも、逃げてない。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……練習だから。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ふふっ。\n夜空、えらい。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "子ども扱いしないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "子ども扱いじゃないよ。\n大事な妹扱いです。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "それ、ずるい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "今日は美空もずるい担当です。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "店長の影響。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "俺か。"
    },
    {
      "speaker": "夜空",
      "text": "だいたい店長。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "でも、店長の影響で夜空が少し素直になるなら、わたしは嬉しいです。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "美空。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "言いたいから言うの。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
