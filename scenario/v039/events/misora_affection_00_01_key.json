    {
      "speaker": "藍",
      "text": "強そうですね……"
    },
    {
      "speaker": "美空",
      "text": "中ボスくらい？"
    },
    {
      "speaker": "藍",
      "text": "中ボスですね……"
    },
    {
      "speaker": "美空",
      "text": "翻訳してみる？"
    },
    {
      "speaker": "藍",
      "text": "やってみます"
    },
    {
      "speaker": "",
      "text": "藍が翻訳サイトを開く。"
