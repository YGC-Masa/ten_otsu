    },
    {
      "speaker": "藍",
      "text": "はい……"
    },
    {
      "speaker": "",
      "text": "美空がマウスを動かす。"
    },
    {
      "speaker": "",
      "text": "藍が不安そうに画面を見守る。"
    },
    {
      "speaker": "美空",
      "text": "ここかな？"
    },
    {
      "speaker": "藍",
      "text": "たぶん……"
    },
    {
      "speaker": "美空",
      "text": "えい"
    },
    {
      "speaker": "",
      "text": "クリックする。"
    },
    {
      "speaker": "",
      "text": "画面が切り替わる。"
    },
    {
      "speaker": "",
      "text": "Permission Denied"
    },
    {
      "speaker": "美空",
      "text": "ぱーみっしょんでねーど"
    },
    {
      "speaker": "藍",
      "text": "ぱーみっしょんでねーどです"
