  "steps": [
    {
      "speaker": "",
      "text": "昼前。",
      "bg": "images/assets/bgev/bg_office_hidamari.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "",
      "text": "接客がひと段落し、店内も少し落ち着いていた。"
    },
    {
      "speaker": "",
      "text": "事務所へ飲み物を取りに来た美空は、小さなうめき声を聞いて足を止める。"
    },
    {
      "speaker": "藍",
      "text": "うぅ……",
      "storySprites": [
        {
          "id": "ab",
          "src": "images/assets/char/b10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "藍ちゃん？",
      "storySprites": [
        {
          "id": "ab",
          "src": "images/assets/char/b10101.webp",
          "opacity": 1
        },
        {
          "id": "ah",
          "src": "images/assets/char/h10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "パソコンの前。"
    },
    {
      "speaker": "",
      "text": "速水川藍が、難しい顔で画面を見つめていた。"
    },
    {
      "speaker": "藍",
      "text": "あ……\n美空ちゃん"
    },
    {
      "speaker": "美空",
      "text": "どうしたの？"
    },
    {
      "speaker": "藍",
      "text": "その……"
    },
    {
      "speaker": "",
      "text": "藍は画面を指差した。"
    },
    {
      "speaker": "藍",
      "text": "取引先さんとのグループチャットなんですけど……\n明日までに送らないといけない資料があって……"
    },
    {
      "speaker": "美空",
      "text": "うんうん"
    },
    {
      "speaker": "藍",
      "text": "添付ファイルを開こうとしたら……\n変な画面になっちゃって……"
    },
    {
      "speaker": "美空",
      "text": "どれどれ？"
    },
    {
      "speaker": "",
      "text": "藍が少し席をずらす。"
    },
    {
      "speaker": "",
      "text": "美空が隣から画面を覗き込む。"
    },
    {
      "speaker": "",
      "text": "画面には英語のメッセージが表示されていた。"
    },
    {
      "speaker": "",
      "text": "Access Denied"
    },
    {
      "speaker": "美空",
      "text": "アクセスでねーど？"
    },
    {
      "speaker": "藍",
      "text": "アクセスでねーど……？"
    },
    {
      "speaker": "美空",
      "text": "アクセスできないどってこと？"
    },
    {
      "speaker": "",
      "text": "藍は少し考える。"
    },
    {
      "speaker": "藍",
      "text": "できないど……ですかね……"
    },
    {
      "speaker": "美空",
      "text": "できないどだね？"
    },
    {
      "speaker": "藍",
      "text": "できないどですね……"
    },
    {
      "speaker": "",
      "text": "二人で頷く。"
    },
    {
      "speaker": "美空",
      "text": "なるほど"
    },
    {
      "speaker": "藍",
      "text": "なるほど……？"
    },
    {
      "speaker": "美空",
      "text": "分からん"
    },
    {
      "speaker": "藍",
      "text": "分かりませんね……"
    },
    {
      "speaker": "",
      "text": "藍の肩が、また少し落ちる。"
    },
    {
      "speaker": "藍",
      "text": "どうしよう……\n明日までに送らないといけないのに……"
    },
    {
      "speaker": "美空",
      "text": "草壁さんは？"
    },
    {
      "speaker": "藍",
      "text": "今日お休みです"
    },
    {
      "speaker": "美空",
      "text": "里美さんは？"
    },
    {
