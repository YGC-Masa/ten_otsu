    },
    {
      "speaker": "美空",
      "text": "お願い！"
    },
    {
      "speaker": "藍",
      "text": "お願いします……！"
    },
    {
      "speaker": "",
      "text": "二人で事情を説明する。"
    },
    {
      "speaker": "",
      "text": "店長は画面を確認した。"
    },
    {
      "speaker": "店長",
      "text": "ああ\nこれか"
    },
    {
      "speaker": "",
      "text": "数回クリック。"
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "藍",
      "text": "あっ！\n開いた……！"
    },
    {
      "speaker": "店長",
