    {
      "speaker": "緋奈",
      "text": "はい！　彩愛さんが分担表作ってくれたので！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "里美",
      "text": "すごく分かりやすかったです〜",
