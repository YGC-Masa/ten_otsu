      ]
    },
    {
      "speaker": "店長",
      "text": "あ、すみません"
    },
    {
      "speaker": "彩愛",
      "text": "謝られても困ります",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しいですね"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。わたくしも、少し難しい女かもしれませんわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そういう意味では"
    },
    {
      "speaker": "彩愛",
      "text": "分かっております。少し意地悪を言いました",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、楽しそうに目を細める。"
    },
    {
      "speaker": "",
      "text": "そこへ、休憩室の入口から緋奈がひょこっと顔を出した。"
    },
    {
      "speaker": "緋奈",
      "text": "あれ？　店長と彩愛さん、なんかいい感じです？",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "緋奈"
    },
    {
      "speaker": "緋奈",
      "text": "はい、今のは見なかったことにします！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "まだ何もしておりませんわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "まだ！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "緋奈さん",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "はい！　撤退します！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "里美の声が奥から聞こえる。"
    },
    {
      "speaker": "里美",
      "text": "緋奈ちゃん〜、邪魔をしてはいけません〜",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "わかってるー！　じゃあ、お二人ともお疲れ様でしたー！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "緋奈は慌ただしく戻っていった。"
    },
    {
      "speaker": "店長",
      "text": "……見られましたね"
    },
    {
      "speaker": "彩愛",
      "text": "見られましたわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "なぜ謝るのです？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "なんとなく"
    },
    {
      "speaker": "彩愛",
      "text": "ふふ。店長は、本当に不思議な方ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "そう言って、彩愛さんは台帳を閉じた。"
    },
    {
      "speaker": "彩愛",
      "text": "では、行きましょうか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "",
      "text": "---"
    },
    {
      "speaker": "",
      "text": "駅前の小さな店は、ビールフェスのような賑やかさはなかった。"
    },
    {
      "speaker": "",
      "text": "木目のカウンター。\n低めの照明。\n静かな音楽。"
    },
    {
      "speaker": "",
      "text": "仕事帰りの人が数人、穏やかにグラスを傾けている。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは席に着くと、メニューを静かに眺めた。"
    },
    {
      "speaker": "彩愛",
      "text": "落ち着いたお店ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "前に通りかかって、彩愛さんが好きそうだなと思って"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしが？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい。賑やかすぎないし、ビールの種類も少しあります"
    },
    {
      "speaker": "彩愛",
      "text": "……そういうところですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "また言われた"
    },
    {
      "speaker": "彩愛",
      "text": "何度でも言います",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ照れたようにメニューへ視線を戻した。"
    },
    {
      "speaker": "店長",
      "text": "何にします？"
    },
    {
      "speaker": "彩愛",
      "text": "そうですわね。今日は軽めのエールにいたします",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "この前のフェスみたいに、解説はありますか？"
    },
    {
      "speaker": "彩愛",
      "text": "店長は、わたくしをビール案内係だと思っていらっしゃるのですか？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "少しだけ"
    },
    {
      "speaker": "彩愛",
      "text": "まったく",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは困ったように笑いながら、メニューの一つを指さした。"
    },
    {
      "speaker": "彩愛",
      "text": "こちらは、香りが軽くて飲みやすいタイプだと思いますわ。食事と合わせやすいかと",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、俺もそれにします"
    },
    {
      "speaker": "彩愛",
      "text": "即決ですの？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんのおすすめなら"
    },
    {
      "speaker": "彩愛",
      "text": "……そういうところです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "謝られると、それはそれで困ります",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "注文を終え、グラスが運ばれてくる。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは軽くグラスを持ち上げた。"
    },
    {
      "speaker": "彩愛",
      "text": "今日もお疲れ様でした",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "お疲れ様でした"
    },
    {
      "speaker": "",
      "text": "軽くグラスを合わせる。"
    },
    {
      "speaker": "",
      "text": "ビールを一口飲んだ彩愛さんは、ほんの少しだけ目元を緩めた。"
    },
    {
      "speaker": "彩愛",
      "text": "……美味しいですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "よかったです"
    },
    {
      "speaker": "彩愛",
      "text": "店長は？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "美味しいです"
    },
    {
      "speaker": "彩愛",
      "text": "それは何よりです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "しばらく、仕事の話をした。"
    },
    {
      "speaker": "",
      "text": "家事応援フェアのこと。\n緋奈のPOPのこと。\n里美のメモ整理のこと。\n相談が増えてきた生活家電売場のこと。"
    },
    {
      "speaker": "",
      "text": "店で話す時よりも、少しだけゆっくりと言葉が流れる。"
    },
    {
      "speaker": "彩愛",
      "text": "最近、少しだけ分かってきました",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "何がですか？"
    },
    {
      "speaker": "彩愛",
      "text": "人に頼ることです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "おお"
    },
    {
      "speaker": "彩愛",
      "text": "まだおおげさに驚くほどではありませんわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "けれど、緋奈さんや里美にお願いすると、わたくし一人では出せないものが出てきます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "それは、少し悔しくもあり、嬉しくもあります",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "前にも言ってましたね"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。やはり少し悔しいです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんらしいです"
    },
    {
      "speaker": "彩愛",
      "text": "ですが、嬉しいのも本当ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、グラスを置いた。"
    },
    {
      "speaker": "彩愛",
      "text": "完璧ではなくても、頼れる人がいる",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "あの言葉、しばらく覚えておきます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "俺も覚えておきます"
    },
    {
      "speaker": "彩愛",
      "text": "店長が？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい。俺も、一人で抱え込むことはありますから"
    },
    {
      "speaker": "彩愛",
      "text": "店長も？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "店長なので"
    },
    {
      "speaker": "彩愛",
      "text": "ふふ。理由になっているような、なっていないような",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "たしかに"
    },
    {
      "speaker": "",
      "text": "彩愛さんは少し笑った。"
    },
    {
      "speaker": "",
      "text": "その笑顔は、店にいる時より少しだけ柔らかい。"
    },
    {
      "speaker": "彩愛",
      "text": "でしたら、店長も誰かに頼る練習をなさってくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんに？"
    },
    {
      "speaker": "彩愛",
      "text": "……わたくしでよろしければ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "頼ります"
    },
    {
      "speaker": "彩愛",
      "text": "即答ですの？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "もう少し悩んでくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "悩むところですか？"
    },
    {
      "speaker": "彩愛",
      "text": "……悩まないのも、それはそれで困ります",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しいですね"
    },
    {
      "speaker": "彩愛",
      "text": "本当に",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "二人で少し笑う。"
    },
    {
      "speaker": "",
      "text": "それから、短い沈黙が落ちた。"
    },
    {
      "speaker": "",
      "text": "気まずい沈黙ではない。"
    },
    {
      "speaker": "",
      "text": "グラスの中の泡が消えていく音まで聞こえそうな、静かな時間だった。"
    },
    {
      "speaker": "彩愛",
      "text": "店長",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "今日は、誘ってくださってありがとうございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "こちらこそ、来てくれてありがとうございます"
    },
    {
      "speaker": "彩愛",
      "text": "お礼の応酬ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ですね"
    },
    {
      "speaker": "彩愛",
      "text": "でも……嬉しかったです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そうですか"
    },
    {
      "speaker": "彩愛",
      "text": "はい。店長からのお誘いでしたから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "その言葉に、少しだけ胸が跳ねた。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、まるで何でもないことのようにグラスへ視線を落としている。"
    },
    {
      "speaker": "",
      "text": "けれど、頬は少しだけ赤い。"
    },
    {
      "speaker": "店長",
      "text": "また誘ってもいいですか？"
    },
    {
      "speaker": "彩愛",
      "text": "……",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、一瞬だけ黙った。"
    },
    {
      "speaker": "",
