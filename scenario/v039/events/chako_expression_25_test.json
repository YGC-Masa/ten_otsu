          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "チャコ",
      "text": "［02/25 やさしい微笑み］細かい崩れまで一緒に見てくれるんだね。ありがとう、ちょっと嬉しい。",
      "expressionId": "02",
      "expressionLabel": "やさしい微笑み",
