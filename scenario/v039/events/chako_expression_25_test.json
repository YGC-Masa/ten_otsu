          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "チャコ",
      "text": "［03/25 笑顔］レスポンシブ表示も問題なし！　これなら端末が変わっても綺麗に見えるよ。",
      "expressionId": "03",
      "expressionLabel": "笑顔",
