          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "チャコ",
      "text": "［04/25 怒り］……待って。さっき直したCSSが反映されてない。誰か上書きした？",
