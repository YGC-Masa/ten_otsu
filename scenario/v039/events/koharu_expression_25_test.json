  "summary": "販売勝負のあと、見当たらなくなったゲームコントローラーを店長と探しながら、小春の正式25表情を順番に確認する表示確認用シナリオ。",
  "testPurpose": "天神 小春の採用済み正式25表情について、最新manifestの画像パスで表示、切替、透過、位置、トリミングを一巡確認する。",
  "steps": [
    {"bg":"images/assets/bg/battle_store_lv1.png","speaker":"","text":"【表情テスト】小春と消えた勝負コントローラー","bgMode":"forceReplace","clearStorySprites":true,"forceBackgroundReplace":true},
    {"speaker":"","text":"販売勝負のあと。ひだまりストアに残った店長と、ビリビリ電機の小春は少しだけ居残っていた。"},
    {"speaker":"天神 小春","text":"［01/25 澄まし］あんた、まだいたの？　ちょうどいいわ。うちの忘れ物探し、ちょっと付き合いなさい。","expressionId":"01","expressionLabel":"澄まし","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_01_composed.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［02/25 やさしい微笑み］……ま、手伝ってくれるなら助かる。ありがと。","expressionId":"02","expressionLabel":"やさしい微笑み","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_02_gentle_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［03/25 笑顔］よーし！　見つけたら今度こそゲームで勝負よ！","expressionId":"03","expressionLabel":"笑顔","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_03_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［04/25 怒り］ちょっと！　さっきまでここに置いてたコントローラー、どこいったのよ！","expressionId":"04","expressionLabel":"怒り","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_04_anger.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［05/25 軽い嫌悪］誰よ、ケーブルぐちゃぐちゃにしたの。こういう雑なの、ほんっとイヤ。","expressionId":"05","expressionLabel":"軽い嫌悪","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_05_mild_disgust.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［06/25 悲しみ］お気に入りだったのに……なくしたとか、さすがにへこむんだけど。","expressionId":"06","expressionLabel":"悲しみ","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_06_sadness.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［07/25 心配／不安］もしかして誰か持って帰った？　……ねえ、あんた本当に知らない？","expressionId":"07","expressionLabel":"心配／不安","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_07_worry.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［08/25 動揺］えっ！？　棚の裏から音した！　な、なによ今の！","expressionId":"08","expressionLabel":"動揺","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_08_agitated.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［09/25 驚き］うそ、そこ開くの！？　そんな収納あったんだ。","expressionId":"09","expressionLabel":"驚き","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_09_surprise.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［10/25 照れ］ち、近いって！　一緒に覗くなら先に言いなさいよ……。","expressionId":"10","expressionLabel":"照れ","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_10_shy.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［11/25 期待］この隙間、怪しくない？　なんかありそう！","expressionId":"11","expressionLabel":"期待","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_11_expectation.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［12/25 得意げ］ふふん、うちの勘を甘く見ないことね。","expressionId":"12","expressionLabel":"得意げ","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_12_proud.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［13/25 いたずらな笑顔・舌出しウィンク］ほら、あんたが先に手ぇ突っ込んでみて？　……なんてね、べーっ。","expressionId":"13","expressionLabel":"いたずらな笑顔・舌出しウィンク","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_13_playful_tongue_wink.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［14/25 いたずらな笑顔・歯見せウィンク］見つけたらご褒美に一勝くらい譲ってあげよっか？　冗談よ。","expressionId":"14","expressionLabel":"いたずらな笑顔・歯見せウィンク","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_14_playful_toothy_wink.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［15/25 困り笑い］あれぇ？　箱しかない。ここまで来て空振りとかある？","expressionId":"15","expressionLabel":"困り笑い","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_15_troubled_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［16/25 真剣／決意］よし、こうなったら徹底的に探す。勝負より先に決着つけるわよ。","expressionId":"16","expressionLabel":"真剣／決意","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_16_determined.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［17/25 伏し目／余韻］……ゲームで勝った負けたって騒げるの、なんだかんだ楽しいんだよね。","expressionId":"17","expressionLabel":"伏し目／余韻","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_17_downcast_afterglow.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［18/25 拗ね／ぷいっ］べ、別にあんたと遊びたいから探してるんじゃないし。","expressionId":"18","expressionLabel":"拗ね／ぷいっ","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_18_sulking.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［19/25 泣き笑い］あったぁ！　よかった……ほんとに、なくしてなかった。","expressionId":"19","expressionLabel":"泣き笑い","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_19_tearful_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［20/25 無言の圧／見透かす］……で？　机の下に落としたの、最初から気づいてたんじゃないでしょうね。","expressionId":"20","expressionLabel":"無言の圧／見透かす","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_20_silent_pressure.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［21/25 黒い笑顔］ふふ……もし黙ってたなら、次の販売勝負、覚悟しときなさい？","expressionId":"21","expressionLabel":"黒い笑顔","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_21_dark_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［22/25 安堵］ま、見つかったならいいわ。ありがと、あんた。","expressionId":"22","expressionLabel":"安堵","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_22_relieved.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［23/25 見惚れ／ときめき］……次の勝負、ちゃんと来るわよね。来なかったら、その……つまんないし。","expressionId":"23","expressionLabel":"見惚れ／ときめき","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_23_captivated.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［24/25 眠そう］ふぁ……さすがに閉店後まで騒いでたら眠くなってきた。","expressionId":"24","expressionLabel":"眠そう","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_24_sleepy.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"天神 小春","text":"［25/25 照れ隠し怒り］なによその顔！　うちが楽しみにしてるみたいに言うな！　……次も絶対来なさいよ！","expressionId":"25","expressionLabel":"照れ隠し怒り","storySprites":[{"id":"ba","src":"images/assets/char/ba_koharu/standing/ba_koharu_expression_25_bashful_anger.webp","side":"center","left":"50%","zIndex":2500,"opacity":1,"maxHeight":"min(68dvh, 700px)"}]},
    {"speaker":"","text":"（小春の25表情をすべて確認しました）"}
  ]
}
