    },
    {
      "speaker": "店長",
      "text": "ですね。でも、緋奈の言う通りだと思います"
    },
    {
      "speaker": "彩愛",
      "text": "店長まで、ですか？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
