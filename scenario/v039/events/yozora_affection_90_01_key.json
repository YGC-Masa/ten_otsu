    "spritePosition": "logical_split_n_plus_1",
    "eventCgLayer": "frontOfCharacters"
  },
  "steps": [
    {
      "speaker": "",
      "text": "――ひだまりストア・閉店後の売り場――",
      "bg": "images/assets/bg/battle_store_lv1.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "店長",
      "text": "夜空、今日の閉店チェックも助かった。"
    },
    {
      "speaker": "夜空",
      "text": "……うん。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日は、受け取るのが早いな。"
    },
    {
      "speaker": "夜空",
      "text": "練習の成果。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "いい成果だな。"
    },
    {
      "speaker": "夜空",
      "text": "褒めすぎ。短めでも、褒められると恥ずかしい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "夜空はレジ横のラックを整える。イベント案内のチラシが何枚か並んでいて、夜空の手がその一枚で止まった。"
    },
    {
      "speaker": "店長",
      "text": "また何か見つけたのか？"
    },
    {
      "speaker": "夜空",
      "text": "……またってなに。羽白湖の時のこと、覚えてなくていい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "忘れないで、かもしれないだろ。"
    },
    {
      "speaker": "夜空",
      "text": "……ずるい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "夜空はチラシを手に取る。そこには、小さな書店とカフェが共同で開く「静かな夜のブックカフェ企画」と書かれていた。"
    },
    {
      "speaker": "店長",
      "text": "夜のブックカフェ？　本を読みながら、温かい飲み物を飲むイベントか。夜限定なんだな。"
    },
    {
      "speaker": "夜空",
      "text": "店内の照明を少し落として、静かな音楽を流すって書いてある。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "夜空、こういうの好きそうだな。"
    },
    {
      "speaker": "夜空",
      "text": "……そういう決めつけ。違わないけど。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "気になるのか？"
    },
    {
      "speaker": "夜空",
      "text": "前回、寒かったから。羽白湖は綺麗だったけど、寒かった。ここなら、寒くない。本もある。静かそう。確認にはちょうどいい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "確認か。飲み物もあるみたいだな。"
    },
    {
      "speaker": "夜空",
      "text": "ココアもあるって書いてある。……たまたま見えただけ。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "そこへ、美空が閉店チェック用のファイルを抱えて戻ってくる。"
    },
    {
      "speaker": "美空",
      "text": "店長、夜空。閉店チェック、終わりました。あれ？ 夜空、それ何のチラシ？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……別に。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "別に、って言う時は気になってる時だよね。見せて？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "夜空は少し迷ってから、チラシを美空へ渡す。"
    },
    {
      "speaker": "美空",
      "text": "静かな夜のブックカフェ企画……。わぁ、夜空好きそう。あったかいし、静かだし、本も読めるし。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "みんなしてそれ言う。前回、寒かったから。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "羽白湖、寒かったもんね。夜空も冷えてたよ？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "ぼくはいい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "よくない。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ねえ、夜空。今回は、店長と二人で行ってきなよ。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……は？",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "二人で？"
    },
    {
      "speaker": "美空",
      "text": "うん。前回は三人で星を見たでしょ。でも今回は夜空が静かに過ごしたい場所みたいだから。店長と二人で行ってきたらいいと思う。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "二人で行く意味がわからない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "夜空、店長と二人でも大丈夫になってきたでしょ？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "大丈夫じゃない。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "即答だな。"
    },
    {
      "speaker": "夜空",
      "text": "店長は黙ってて。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "夜空が行きたい理由は、美空がいるからだけ？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……そういう聞き方。最近、美空までずるい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "夜空、行きたくないなら無理に行かなくていい。でも、気になるなら一緒に行く。"
    },
    {
      "speaker": "夜空",
      "text": "即答しないで。でも、今のは……少し助かった。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "行ってきなよ。夜空が行きたいなら。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……美空がそう言うなら。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ううん。夜空が、行きたいなら。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "少し沈黙が落ちる。夜空はチラシの端を指でなぞる。"
    },
    {
      "speaker": "夜空",
      "text": "……行きたくないわけじゃない。でも、二人で行くのは……まだ変。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "確認しに行くか？"
    },
    {
      "speaker": "夜空",
      "text": "……確認。静かな本と、ココアと、暖かさの確認。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ふふっ。じゃあ、決まりですね。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "決まりじゃない。仮。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "夜空はチラシを丁寧に自分のバッグへしまう。まだ二人で行くことの意味を、深くは考えていなかった。ただ、静かな夜の本棚と、温かいココアのある場所へ行ってみたい。その気持ちは、確かに夜空自身のものだった。"
    }
  ],
  "keyScenarioIndex": 1
}
