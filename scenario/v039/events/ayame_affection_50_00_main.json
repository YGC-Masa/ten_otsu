          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "里美",
      "text": "なんとなくです〜",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "里美はにこにこしながら、台帳を置いた。"
    },
    {
      "speaker": "里美",
      "text": "では自分、締め作業に戻りますね〜",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ああ、よろしく"
    },
    {
      "speaker": "里美",
      "text": "は〜い",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "里美も事務所へ戻っていった。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、台帳の上に置かれたメモをしばらく見ていた。"
    },
    {
      "speaker": "彩愛",
      "text": "皆さん、本当に見ていらっしゃいますわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ですね"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしが抱え込みすぎると、すぐに見つかってしまいます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それだけ、彩愛さんのことを見てるんだと思います"
    },
    {
      "speaker": "彩愛",
      "text": "……ありがたいことです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、静かにそう言った。"
    },
    {
      "speaker": "店長",
      "text": "最近、少し頼るのが上手くなってきた気がします"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしが？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "そうでしょうか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "緋奈にPOPを任せたり、里美にメモを確認してもらったり"
    },
    {
      "speaker": "彩愛",
      "text": "それは、皆さんが得意なことですから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それに気づいて頼めるのも、彩愛さんの良さだと思います"
    },
    {
      "speaker": "彩愛",
      "text": "……また、そうやって",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "褒めてます"
    },
    {
      "speaker": "彩愛",
      "text": "分かっております",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは少しだけ照れたように視線を逸らした。"
    },
    {
      "speaker": "彩愛",
      "text": "ただ、頼るというのは、少し難しいですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しいですか"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。自分でできることなら、自分でやった方が早いと思ってしまいます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "分かります"
    },
    {
      "speaker": "彩愛",
      "text": "それに、誰かにお願いするということは、その方の時間をいただくことですもの",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも、みんな嫌そうじゃなかったですよ"
    },
    {
      "speaker": "彩愛",
      "text": "それは……そうですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "緋奈なんて、役に立ててすごく嬉しそうでした"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。あの顔を見たら、少し考えが変わりました",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "考えが？"
    },
    {
      "speaker": "彩愛",
      "text": "頼ることは、迷惑をかけることばかりではないのかもしれません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "誰かに役割を渡すことで、その人の良さが出ることもあるのですね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "あります"
    },
    {
      "speaker": "彩愛",
      "text": "緋奈さんの言葉も、里美さんの丁寧な整理も、わたくし一人ではできません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そうですね"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしは、それを少し軽く見ていたのかもしれませんわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "軽く見ていた？"
    },
    {
      "speaker": "彩愛",
      "text": "いえ。違いますわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、ゆっくり首を振った。"
    },
    {
      "speaker": "彩愛",
      "text": "皆さんの力を信じる前に、自分がちゃんとしなければと思いすぎていたのかもしれません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……"
    },
    {
      "speaker": "彩愛",
      "text": "誰かに頼ってもよい。そう言われるより、こうして実際に助けていただく方が、よく分かりますわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "なら、今日のフェアは成功ですね"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。お客様にも、わたくしにも",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、そう言って少しだけ笑った。"
    },
    {
      "speaker": "店長",
      "text": "完璧じゃなくても、頼れる人がいる"
    },
    {
      "speaker": "彩愛",
      "text": "……",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "あ、すみません。今のは少し格好つけました"
    },
    {
      "speaker": "彩愛",
      "text": "いいえ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、売場を見渡した。"
    },
    {
      "speaker": "彩愛",
      "text": "完璧じゃなくても、頼れる人がいる",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "……良い言葉ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ありがとうございます"
    },
    {
      "speaker": "彩愛",
      "text": "お礼を言われると、それはそれで困りますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "いつもの返し。"
    },
    {
      "speaker": "",
      "text": "けれど、声は少し柔らかい。"
    },
    {
      "speaker": "彩愛",
      "text": "店長",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしは、まだ人に頼るのが上手ではありません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "ですが、少しずつ練習してみようと思います",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "いいと思います"
    },
    {
      "speaker": "彩愛",
      "text": "もしまた、ひとりで抱え込みそうになっていたら",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "その時は、少しだけ止めてくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "分かりました"
    },
    {
      "speaker": "彩愛",
      "text": "ただし",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ただし？"
    },
    {
      "speaker": "彩愛",
      "text": "優しくしすぎないように",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……気をつけます"
    },
    {
      "speaker": "彩愛",
      "text": "ふふ。お願いいたします",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、家事応援フェアの売場を見渡した。"
    },
    {
      "speaker": "",
      "text": "POP。\n台帳。\n相談メモ。\n商品棚。"
    },
    {
      "speaker": "",
      "text": "それぞれに、誰かの手が入っている。"
    },
    {
      "speaker": "",
      "text": "緋奈の言葉。\n里美の整理。\n彩愛さんの接客。\nそして、店長としての俺の確認。"
    },
    {
      "speaker": "",
      "text": "一人で完璧に作った売場ではない。"
    },
    {
      "speaker": "",
      "text": "だからこそ、あたたかい売場になっている。"
    },
    {
      "speaker": "彩愛",
      "text": "良い売場ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "ひとりでは、できませんでした",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ですね"
    },
    {
      "speaker": "彩愛",
      "text": "……悔しいような、嬉しいような",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "どちらでもいいんじゃないですか"
    },
    {
      "speaker": "彩愛",
      "text": "そうですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ肩の力を抜いたように笑った。"
    },
    {
      "speaker": "彩愛",
      "text": "完璧ではなくても、頼れる人がいる",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "今日は、そのことを覚えておきますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "閉店後の売場は、静かだった。"
    },
    {
      "speaker": "",
      "text": "けれど、並んだPOPや整えられた台帳が、今日一日の賑やかさを少しだけ残している。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、その売場を見つめながら、穏やかに微笑んでいた。"
    },
    {
      "speaker": "",
      "text": "締めモノローグ"
    },
    {
      "speaker": "",
      "text": "家事応援フェアを通して、彩愛さんは少しずつ人に頼ることを覚え始めた。"
    },
    {
      "speaker": "",
      "text": "緋奈のPOP。\n里美のメモ整理。\n店長の確認。"
    },
    {
      "speaker": "",
      "text": "どれも、彩愛さん一人ではできないことだった。"
    },
    {
      "speaker": "",
      "text": "以前なら、彩愛さんは自分で全部を整えようとしていたかもしれない。\n完璧でいようとして、確認漏れ一つにも強く落ち込んでいたかもしれない。"
    },
    {
      "speaker": "",
      "text": "けれど今日は違った。"
    },
    {
      "speaker": "",
      "text": "間違えたら直せばいい。\n抱え込みそうになったら、誰かに頼ればいい。"
    },
    {
      "speaker": "",
      "text": "完璧じゃなくても、頼れる人がいる。"
    },
    {
      "speaker": "",
      "text": "そのことを、彩愛さんは少しだけ受け取った。"
    },
    {
      "speaker": "",
      "text": "解放後メモ案"
    },
    {
      "speaker": "",
      "text": "紫藤 彩愛 親愛50「完璧じゃなくても、頼れる人」読了。\n家事応援フェアの締めとして、彩愛は緋奈のPOP、里美のメモ整理、店長の確認に助けられながら売場を整えた。\n自分一人で完璧にこなすのではなく、人に頼ることで、その人の良さが出ることもあると気づく。\n彩愛は「完璧じゃなくても、頼れる人がいる」という言葉を受け取り、少しずつ人に頼る練習をしてみようと思い始める。"
    }
  ]
}
