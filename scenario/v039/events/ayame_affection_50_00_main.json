          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ありがとうございます。助かります"
    },
    {
      "speaker": "彩愛",
      "text": "それから、型番確認の欄を少し変えております。旧型と現行型を間違えないよう、比較資料を使った場合は別欄に記入する形にいたしました",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "さっそく改善したんですね"
    },
    {
      "speaker": "彩愛",
      "text": "はい。同じ間違いを繰り返すわけにはまいりませんから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんらしいです"
