      "speaker": "彩愛",
      "text": "また“らしい”ですか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい。いい意味で"
