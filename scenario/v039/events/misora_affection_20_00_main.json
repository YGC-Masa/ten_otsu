    {
      "speaker": "",
      "text": "美空は、少しだけ目を伏せた。"
    },
    {
      "speaker": "",
      "text": "間違っていたのだと思っていた。"
    },
    {
      "speaker": "",
      "text": "自分が勝手に決めつけていたのかもしれないと。"
    },
    {
      "speaker": "",
      "text": "夜空の気持ちを、ちゃんと見ていなかったのかもしれないと。"
    },
    {
      "speaker": "",
      "text": "でも。"
    },
    {
      "speaker": "",
      "text": "夜空が迷わないように。"
    },
    {
      "speaker": "",
      "text": "夜空が選びやすいように。"
    },
    {
      "speaker": "",
      "text": "そう願っていたことまで、間違いにしなくてもいいのかもしれない。"
    },
    {
      "speaker": "美空",
      "text": "……そうですね"
    },
    {
      "speaker": "美空",
      "text": "夜空も"
    },
    {
      "speaker": "美空",
      "text": "私も"
    },
    {
      "speaker": "美空",
      "text": "相手のことを考えてたんですね"
    },
    {
      "speaker": "店長",
      "text": "たぶんな"
    },
    {
      "speaker": "美空",
      "text": "……うん"
    },
    {
      "speaker": "",
      "text": "美空は小さく頷いた。"
    },
    {
      "speaker": "",
      "text": "胸の中の重さが、少しだけ形を変えた。"
    },
    {
      "speaker": "",
      "text": "責めるための重さではなく。"
    },
    {
      "speaker": "",
      "text": "大事にしたいものを、ちゃんと見つめるための重さに。"
    },
    {
      "speaker": "店長",
      "text": "なら"
    },
    {
      "speaker": "店長",
      "text": "夜空に聞いてみてもいいんじゃないか？"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "店長",
      "text": "本当は、どうしたいのか"
    },
    {
      "speaker": "店長",
      "text": "同じものでもいいのか"
    },
    {
      "speaker": "店長",
      "text": "違うものがいいのか"
    },
    {
      "speaker": "店長",
      "text": "美空が決めるんじゃなくてさ"
    },
    {
      "speaker": "美空",
      "text": "夜空に……聞いてみる"
    },
    {
      "speaker": "店長",
      "text": "ああ"
    },
    {
      "speaker": "美空",
      "text": "……そっか"
    },
    {
      "speaker": "美空",
      "text": "……そうですね"
    },
    {
      "speaker": "",
      "text": "美空は、夜空を見上げた。"
    },
    {
      "speaker": "",
      "text": "夜空のことを考えていたのに。"
    },
    {
      "speaker": "",
      "text": "本当の夜空には、まだ聞いていなかった。"
    },
    {
      "speaker": "美空",
      "text": "聞けば、いいんですね"
    },
    {
      "speaker": "店長",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "決めてあげるんじゃなくて"
    },
    {
      "speaker": "美空",
      "text": "聞けばいい"
    },
    {
      "speaker": "店長",
      "text": "ああ"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "美空は、小さく息を吐いた。"
    },
    {
      "speaker": "",
      "text": "その息は、さっきより少し軽かった。"
    },
    {
      "speaker": "美空",
      "text": "それなら"
    },
    {
      "speaker": "美空",
      "text": "私にも、できるかもしれません"
    },
    {
      "speaker": "店長",
      "text": "できるだろ"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "美空",
      "text": "できる気がします"
    },
    {
      "speaker": "",
      "text": "美空は少しだけ笑った。"
    },
    {
      "speaker": "",
      "text": "さっきよりも、自然に。"
    },
    {
      "speaker": "美空",
      "text": "夜空に聞いてみるなら……"
    },
    {
      "speaker": "美空",
      "text": "何からがいいかな"
    },
    {
      "speaker": "店長",
      "text": "重く考えなくていいんじゃないか？"
    },
    {
      "speaker": "美空",
      "text": "重く考えない……"
    },
    {
      "speaker": "店長",
      "text": "飲み物とか"
    },
    {
      "speaker": "店長",
      "text": "そのくらいでも"
    },
    {
      "speaker": "美空",
      "text": "飲み物……"
    },
    {
      "speaker": "",
      "text": "美空は少し考える。"
    },
    {
      "speaker": "",
      "text": "そして、ふっと顔を上げた。"
    },
    {
      "speaker": "美空",
      "text": "……ココア"
    },
    {
      "speaker": "店長",
      "text": "ココア？"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "美空",
      "text": "ココア、飲む？って"
    },
    {
      "speaker": "美空",
      "text": "それなら、聞けそうです"
    },
    {
      "speaker": "店長",
      "text": "いいと思う"
    },
    {
      "speaker": "美空",
      "text": "夜空、なんて言うかな"
    },
    {
      "speaker": "店長",
      "text": "べつに、じゃないか？"
    },
    {
      "speaker": "美空",
      "text": "言いそう"
    },
    {
      "speaker": "店長",
      "text": "でも、飲むだろ"
    },
    {
      "speaker": "美空",
      "text": "……はい"
    },
    {
      "speaker": "美空",
      "text": "飲んでくれる気がします"
    },
    {
      "speaker": "",
      "text": "美空は少しだけ笑った。"
    },
    {
      "speaker": "美空",
      "text": "同じものを選んでも"
    },
    {
      "speaker": "美空",
      "text": "夜空は夜空で"
    },
    {
      "speaker": "美空",
      "text": "私は私"
    },
    {
      "speaker": "美空",
      "text": "でも"
    },
    {
      "speaker": "美空",
      "text": "一緒に嬉しいものも、あるんですね"
    },
    {
      "speaker": "店長",
      "text": "ああ"
    },
    {
      "speaker": "美空",
      "text": "忘れてたら"
    },
    {
      "speaker": "美空",
      "text": "もったいないですね"
    },
    {
      "speaker": "店長",
      "text": "なら、思い出せばいい"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "",
      "text": "美空はゆっくり頷いた。"
    },
    {
      "speaker": "",
      "text": "その顔には、さっきまでの迷いがまだ残っている。"
    },
    {
      "speaker": "",
      "text": "けれど、迷いの奥に、少しだけあたたかいものが戻っていた。"
    },
    {
      "speaker": "美空",
      "text": "私は"
    },
    {
      "speaker": "美空",
      "text": "夜空と違うものを選んでも"
    },
    {
      "speaker": "美空",
      "text": "夜空のお姉ちゃんでいられますか？"
    },
    {
      "speaker": "店長",
      "text": "いられるよ"
    },
    {
      "speaker": "美空",
      "text": "同じものを選んでも？"
    },
    {
      "speaker": "店長",
      "text": "いられるさ"
    },
    {
      "speaker": "美空",
      "text": "私が、夜空みたいなものを好きになっても？"
    },
    {
      "speaker": "店長",
      "text": "それでも、美空は美空だろ"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "店長",
      "text": "夜空と同じものを好きになったって"
    },
    {
      "speaker": "店長",
      "text": "夜空になるわけじゃない"
    },
    {
      "speaker": "店長",
      "text": "美空は、美空のままだ"
    },
    {
      "speaker": "美空",
      "text": "……美空のまま"
    },
    {
      "speaker": "店長",
      "text": "ああ"
    },
    {
      "speaker": "店長",
      "text": "夜空のお姉ちゃんで"
    },
    {
      "speaker": "店長",
      "text": "双沢美空のままだ"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "美空は、胸の前でそっと手を重ねた。"
    },
    {
      "speaker": "",
      "text": "さっきまで不安だったものが、少しだけ形を変える。"
    },
    {
      "speaker": "",
      "text": "同じものを選ぶことは、夜空の場所を奪うことじゃない。"
    },
    {
      "speaker": "",
      "text": "違うものを選ぶことは、夜空から離れることじゃない。"
    },
    {
      "speaker": "",
      "text": "どちらを選んでも。"
    },
    {
      "speaker": "",
      "text": "自分は、自分のままでいい。"
    },
    {
      "speaker": "美空",
      "text": "……そっか"
    },
    {
      "speaker": "美空",
      "text": "そうですよね"
    },
    {
      "speaker": "店長",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "私"
    },
    {
      "speaker": "美空",
      "text": "夜空のお姉ちゃんで"
    },
    {
      "speaker": "美空",
      "text": "双沢美空なんですね"
    },
    {
      "speaker": "店長",
      "text": "そういうことだな"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "なんだか、当たり前のことなのに"
    },
    {
      "speaker": "美空",
      "text": "今、ちょっと安心しました"
    },
    {
      "speaker": "",
      "text": "美空はフェンスから手を離し、胸の前で軽く指を組んだ。"
    },
    {
      "speaker": "美空",
      "text": "私"
    },
    {
      "speaker": "美空",
      "text": "夜空と違うことが"
    },
    {
      "speaker": "美空",
      "text": "二人を守ってるんだと思ってました"
    },
    {
      "speaker": "店長",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "でも"
    },
    {
      "speaker": "美空",
      "text": "同じでも"
    },
    {
      "speaker": "美空",
      "text": "守れるのかもしれませんね"
    },
    {
      "speaker": "店長",
      "text": "そうだな"
    },
    {
      "speaker": "美空",
      "text": "違っても"
    },
    {
      "speaker": "美空",
      "text": "近くにいられるのかもしれませんね"
    },
    {
      "speaker": "店長",
      "text": "そうだな"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "美空は空を見上げる。"
    },
    {
      "speaker": "",
      "text": "夜空が、少しずつ深くなっていく。"
    },
    {
      "speaker": "美空",
      "text": "変ですね"
    },
    {
      "speaker": "店長",
      "text": "何が？"
    },
    {
      "speaker": "美空",
      "text": "夜空のことを考えてたら"
    },
    {
      "speaker": "美空",
      "text": "夜空を見てました"
    },
    {
      "speaker": "店長",
      "text": "名前が名前だからな"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "そうですね"
    },
    {
      "speaker": "",
      "text": "二人で、少しだけ笑う。"
    },
    {
      "speaker": "",
      "text": "美空の表情は、まだ完全には晴れていない。"
    },
    {
      "speaker": "",
      "text": "でも、迷いの中に、少しだけ光が差していた。"
    },
    {
      "speaker": "美空",
      "text": "今日はまだ"
    },
    {
      "speaker": "美空",
      "text": "聞かないでおきます"
    },
    {
      "speaker": "店長",
      "text": "なんで？"
    },
    {
      "speaker": "美空",
      "text": "ちゃんと考えてから聞きたいからです"
    },
    {
      "speaker": "店長",
      "text": "そっか"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "美空",
      "text": "私が、何を選びたいのか"
    },
    {
      "speaker": "美空",
      "text": "夜空に、どう聞きたいのか"
    },
    {
      "speaker": "美空",
      "text": "ちゃんと考えてから"
    },
    {
      "speaker": "店長",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "だから今日は"
    },
    {
      "speaker": "美空",
      "text": "店長に聞いてもらえて、よかったです"
    },
    {
      "speaker": "店長",
      "text": "俺でよければ、いつでも聞くよ"
    },
    {
      "speaker": "美空",
      "text": "ありがとうございます"
    },
    {
      "speaker": "",
      "text": "美空は丁寧に頭を下げた。"
    },
    {
      "speaker": "",
      "text": "そしてすぐ、少し照れたように笑う。"
    },
    {
      "speaker": "美空",
      "text": "でも"
    },
    {
      "speaker": "美空",
      "text": "聞いてもらった分"
    },
    {
      "speaker": "美空",
      "text": "今度、メロンソーダ奢りますね"
    },
    {
      "speaker": "店長",
      "text": "なんでメロンソーダ？"
    },
    {
      "speaker": "美空",
      "text": "店長、好きですよね？"
    },
    {
      "speaker": "店長",
      "text": "よく覚えてるな"
    },
    {
      "speaker": "美空",
      "text": "店長のことですから"
    },
    {
      "speaker": "店長",
      "text": "それ、どういう意味だ？"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "いい意味です"
    },
    {
      "speaker": "店長",
      "text": "本当か？"
    },
    {
      "speaker": "美空",
      "text": "本当です"
    },
    {
      "speaker": "",
      "text": "二人は屋上の扉へ向かって歩き出す。"
    },
    {
      "speaker": "",
      "text": "その途中で、美空はもう一度だけ空を見上げた。"
    },
    {
      "speaker": "",
      "text": "夜空は黒い。"
    },
    {
      "speaker": "",
      "text": "けれど、そこには星があった。"
    },
    {
      "speaker": "美空",
      "text": "同じでも"
    },
    {
      "speaker": "美空",
      "text": "違っても"
    },
    {
      "speaker": "",
      "text": "小さくつぶやく。"
    },
    {
      "speaker": "店長",
      "text": "ん？"
    },
    {
      "speaker": "美空",
      "text": "なんでもないです"
    },
    {
      "speaker": "",
      "text": "美空は笑った。"
    },
    {
      "speaker": "",
      "text": "今はまだ、答えではない。"
    },
    {
      "speaker": "",
      "text": "けれど、夜空に聞いてみたいことができた。"
    },
    {
      "speaker": "",
      "text": "それだけで、少し前に進めた気がした。"
    }
  ]
}
