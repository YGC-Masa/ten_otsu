      ]
    },
    {
      "speaker": "速水川 藍",
      "text": "［25/25 照れ隠し怒り］『可愛い寝顔も見てみたい』は余計です。もう、からかわないでください……。",
      "expressionId": "25",
      "expressionLabel": "照れ隠し怒り",
      "storySprites": [
        {
          "id": "ab",
          "src": "images/assets/char/ab_ai/standing/25_照れ隠し怒り.webp",
