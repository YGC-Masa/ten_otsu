          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "草壁 萌",
      "text": "［05/25 軽い嫌悪］まさか、べたべたの古いテープと一緒に捨てたんじゃ……それは、ちょっと嫌だな。",
      "expressionId": "05",
      "expressionLabel": "軽い嫌悪",
