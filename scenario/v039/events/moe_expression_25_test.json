          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "草壁 萌",
      "text": "［02/25 やさしい微笑み］ふふ。おにいちゃんと一緒なら、準備も楽しいね。",
      "expressionId": "02",
      "expressionLabel": "やさしい微笑み",
      "storySprites": [
        {
          "id": "am",
