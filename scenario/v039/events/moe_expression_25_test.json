          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "草壁 萌",
      "text": "［03/25 笑顔］よかった。新しい案内札も、ちゃんと見やすくできたよ。",
      "expressionId": "03",
      "expressionLabel": "笑顔",
      "storySprites": [
        {
          "id": "am",
          "src": "images/assets/char/am_moe/standing/am_moe_expression_03_smile.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "ところが、萌が作った案内札が、机の上から消えていた。"
    },
    {
      "speaker": "草壁 萌",
      "text": "［04/25 怒り］もう……誰かが勝手に動かしたなら、ちゃんと元に戻してもらわないと。",
