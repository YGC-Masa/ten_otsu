          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "草壁 萌",
      "text": "［06/25 悲しみ］一生懸命書いたのに……なくなっちゃったら、悲しいよ。",
      "expressionId": "06",
      "expressionLabel": "悲しみ",
      "storySprites": [
        {
          "id": "am",
          "src": "images/assets/char/am_moe/standing/am_moe_expression_06_sadness.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
