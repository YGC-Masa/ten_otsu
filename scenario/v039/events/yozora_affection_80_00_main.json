        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "いつの間に。"
    },
    {
      "speaker": "夜空",
      "text": "店を出る前。\n自販機で。",
      "storySprites": [
