      "storySprites": [{"id":"ad","src":"images/assets/char/ad_kogane/standing/ad_kogane_expression_01.webp","side":"center","left":"50%","zIndex":2500,"opacity":1}]
    },
    {
      "speaker": "小麦沢 こがね",
      "text": "［02/25 やさしい微笑み］だいじょぶだって。店長とあーしなら、すぐ終わるっしょ。",
      "expressionId": "02",
      "expressionLabel": "やさしい微笑み",
