      "storySprites": [{"id":"ad","src":"images/assets/char/ad_kogane/standing/ad_kogane_expression_08.webp","side":"center","left":"50%","zIndex":2500,"opacity":1}]
    },
    {
      "speaker": "小麦沢 こがね",
      "text": "［09/25 驚き］あっ！　この英文、POPに書いたキャッチコピーじゃん！",
