    {
      "speaker": "",
      "text": "――送信。\nしばらくして、画面に既読がつく。"
    },
    {
      "speaker": "店長",
      "text": "既読になった。"
    },
    {
      "speaker": "美空",
      "text": "返事は？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "まだ。"
    },
    {
      "speaker": "",
      "text": "――数秒後、短い返事が届く。"
    },
    {
      "speaker": "夜空",
      "text": "『大丈夫』",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
