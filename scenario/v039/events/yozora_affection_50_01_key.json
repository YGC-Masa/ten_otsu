    {
      "speaker": "店長",
      "text": "わかった。"
    },
    {
      "speaker": "美空",
      "text": "店長。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
