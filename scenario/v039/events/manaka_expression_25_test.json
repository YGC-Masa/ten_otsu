          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "大道寺 真花",
      "text": "［05/25 軽い嫌悪］使用済みのパフを未洗浄のまま戻すのは、衛生的によくありませんね。",
      "expressionId": "05",
      "expressionLabel": "軽い嫌悪",
      "storySprites": [
