          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "大道寺 真花",
      "text": "［03/25 笑顔］このライトなら肌の色が自然に見えます。お客様にも喜んでいただけそうです。",
      "expressionId": "03",
      "expressionLabel": "笑顔",
      "storySprites": [
        {
          "id": "af",
          "src": "images/assets/char/af_manaka/standing/af_manaka_expression_03_smile.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "大道寺 真花",
      "text": "［04/25 怒り］……あの、美容ポーチがありません。ここへ置いたはずなのに。",
      "expressionId": "04",
      "expressionLabel": "怒り",
      "storySprites": [
        {
          "id": "af",
