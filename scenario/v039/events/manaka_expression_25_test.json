          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "大道寺 真花",
      "text": "［02/25 やさしい微笑み］緊張した時は、鏡の前で深呼吸するといいんです。店長も試しますか？",
      "expressionId": "02",
      "expressionLabel": "やさしい微笑み",
      "storySprites": [
        {
          "id": "af",
