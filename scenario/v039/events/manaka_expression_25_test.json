          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "大道寺 真花",
      "text": "［06/25 悲しみ］大切に集めた色見本も入っているんです。なくしてしまったら……。",
