          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［07/25 心配／不安］アレルギー表示も箱に添えています。誰かが先に開けていないか、心配です。",
      "expressionId": "07",
      "expressionLabel": "心配／不安",
      "storySprites": [
        {
