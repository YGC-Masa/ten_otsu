          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［15/25 困り笑い］あら……足跡が二手に分かれています。砂糖をこぼしすぎましたね。",
      "expressionId": "15",
      "expressionLabel": "困り笑い",
      "storySprites": [
        {
          "id": "ag",
