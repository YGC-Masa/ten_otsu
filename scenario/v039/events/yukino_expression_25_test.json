          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［03/25 笑顔］今回は三種類です。皆様が喜んでくださると、嬉しいのですが。",
      "expressionId": "03",
      "expressionLabel": "笑顔",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_03_smile.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［04/25 怒り］……お配りする箱が、ありません。先ほどまで机の上にあったはずです。",
      "expressionId": "04",
      "expressionLabel": "怒り",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_04_anger.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［05/25 軽い嫌悪］この棚、なぜかピクルスの匂いがしますね。お菓子を置く場所ではありません。",
      "expressionId": "05",
      "expressionLabel": "軽い嫌悪",
      "storySprites": [
