          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［06/25 悲しみ］皆様のお顔を思い浮かべながら作ったのに……なくしてしまったのでしょうか。",
      "expressionId": "06",
      "expressionLabel": "悲しみ",
      "storySprites": [
        {
