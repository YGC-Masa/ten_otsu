    },
    {
      "speaker": "氷神 雪乃",
      "text": "［09/25 驚き］タイマーの下に白い粉が……砂糖の跡が、廊下へ続いています。",
      "expressionId": "09",
      "expressionLabel": "驚き",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_09_surprise.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［10/25 照れ］暗い倉庫へ行くのですね。あの……少しだけ、そばにいてくださいますか？",
      "expressionId": "10",
      "expressionLabel": "照れ",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_10_shy.webp",
