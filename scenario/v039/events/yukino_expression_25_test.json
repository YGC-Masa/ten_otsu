      "expressionLabel": "真剣／決意",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_16_determined.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［17/25 伏し目／余韻］あのお菓子には、いつもお世話になっている感謝を込めたのです。",
      "expressionId": "17",
      "expressionLabel": "伏し目／余韻",
      "storySprites": [
        {
          "id": "ag",
