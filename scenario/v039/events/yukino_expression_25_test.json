      "expressionLabel": "期待",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_11_expectation.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［12/25 得意げ］粉の粒と香りで分かります。これは、私が使った和三盆です。",
