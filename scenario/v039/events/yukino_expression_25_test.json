          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［08/25 動揺］あっ……オーブンのタイマー？　いえ、もう火は止めたはずです……。",
      "expressionId": "08",
      "expressionLabel": "動揺",
      "storySprites": [
