      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［19/25 泣き笑い］開きました……箱も無事です。よかった……本当によかった。",
      "expressionId": "19",
      "expressionLabel": "泣き笑い",
      "storySprites": [
        {
          "id": "ag",
