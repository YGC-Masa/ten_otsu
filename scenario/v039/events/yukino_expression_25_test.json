      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［23/25 見惚れ／ときめき前］箱に『雪乃へ、いつもありがとう』と……貴方様が書いてくださったのですか？",
      "expressionId": "23",
      "expressionLabel": "見惚れ／ときめき前",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_23_captivated.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
