          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［13/25 いたずらな笑顔・舌出しウィンク］名探偵・雪乃、と名乗ってもよろしいでしょうか。……少しだけ、です。",
      "expressionId": "13",
      "expressionLabel": "いたずらな笑顔・舌出しウィンク",
      "storySprites": [
        {
