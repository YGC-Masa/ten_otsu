          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［16/25 真剣／決意］冷たい空気が流れてきます。保冷庫の方を調べましょう。",
