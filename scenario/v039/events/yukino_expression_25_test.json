          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［20/25 無言の圧／見透かす］……貴方様。なぜ、その鍵をお持ちだったのですか？",
      "expressionId": "20",
      "expressionLabel": "無言の圧／見透かす",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_20_silent_pressure.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "氷神 雪乃",
      "text": "［21/25 黒い微笑み／不穏］まさか、最初から箱の場所をご存じだった……ということはありませんよね？",
      "expressionId": "21",
      "expressionLabel": "黒い微笑み／不穏",
      "storySprites": [
        {
          "id": "ag",
          "src": "images/assets/char/ag_yukino/standing/ag_yukino_expression_21_dark_smile.webp",
