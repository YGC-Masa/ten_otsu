    {
      "speaker": "彩愛",
      "text": "店長まで",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません。でも、少し聞いてみたいです"
