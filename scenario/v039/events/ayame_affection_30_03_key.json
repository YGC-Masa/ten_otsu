        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "彩愛さんも行くなら決定ですね！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "決定が早すぎますわ",
