      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、シフトを確認して、行ける人で少し寄るくらいにするか"
