          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんの目が、ほんの少しだけ明るくなった。"
    },
    {
      "speaker": "",
      "text": "本当に、ほんの少し。"
    },
    {
      "speaker": "",
      "text": "けれど、俺には分かった。"
    },
    {
      "speaker": "店長",
      "text": "彩愛さん、今ちょっと反応しましたね"
    },
    {
      "speaker": "彩愛",
      "text": "……そうでしょうか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "しました！　絶対しました！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "里美",
      "text": "彩愛さん、ビールお好きですもんね〜",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "嗜む程度ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "嗜む程度"
    },
    {
      "speaker": "緋奈",
      "text": "あ、出ました。彩愛さんの上品ワード！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
