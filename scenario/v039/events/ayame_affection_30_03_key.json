      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "里美",
      "text": "行きたいです〜。でも自分、飲みすぎると帰る方向が分からなくなります〜",
      "storySprites": [
        {
          "id": "al",
          "src": "images/assets/char/l10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それは元からだろ"
