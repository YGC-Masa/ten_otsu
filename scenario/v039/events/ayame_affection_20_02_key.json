    },
    {
      "speaker": "彩愛",
      "text": "緋奈さん",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "あ、でも楽しそうです！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
