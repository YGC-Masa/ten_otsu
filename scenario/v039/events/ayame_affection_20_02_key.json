    {
      "speaker": "彩愛",
      "text": "そんなに面白いものではありませんわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも、彩愛さんのことが少し分かります"
    },
    {
      "speaker": "彩愛",
      "text": "……また、そういうことを",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "だめでした？"
    },
    {
      "speaker": "彩愛",
      "text": "だめではありません。ただ、少し困るだけです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、また困らせましたね"
