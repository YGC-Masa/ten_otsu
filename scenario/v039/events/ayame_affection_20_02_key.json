        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "慣れておりません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "少し慣れてきた気はします"
    },
    {
      "speaker": "彩愛",
      "text": "店長",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "褒めすぎ注意ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "里美さんみたいですね！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "緋奈さん",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "はい、すみません！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "緋奈は笑いながら、別の売場へ戻っていった。"
    },
    {
      "speaker": "",
      "text": "調理家電売場には、俺と彩愛さんが残る。"
    },
    {
      "speaker": "店長",
      "text": "川遊びの話、前にも少しだけ出ましたよね"
    },
    {
      "speaker": "彩愛",
      "text": "そうでしたか？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "おやつの話の時に。川では昔よく遊んだけど、今はあまり近づかないって"
    },
    {
      "speaker": "",
      "text": "彩愛さんは一瞬だけ黙った。"
    },
    {
      "speaker": "彩愛",
      "text": "……ええ。そうお話ししましたわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今はあまり、なんですか？"
    },
    {
      "speaker": "彩愛",
      "text": "大人になりましたから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それだけですか？"
    },
    {
      "speaker": "彩愛",
      "text": "……",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少し困ったように笑った。"
    },
    {
      "speaker": "彩愛",
      "text": "店長は、時々鋭すぎますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
