        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "お客様・男性",
      "text": "はい。グリルの掃除が大変なので、レンジで楽に焼けるならと思って"
    },
    {
      "speaker": "彩愛",
      "text": "それでしたら、自動調理機能のあるものが便利ですわ。焼き加減を調整できる機種もございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "こちらは魚の種類に合わせた自動メニューがあります"
    },
    {
      "speaker": "お客様・男性",
      "text": "魚の種類で変えられるんですね"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。魚は大きさや脂の乗り方で火の通りが変わりますから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "お客様・男性",
      "text": "なるほど"
    },
    {
      "speaker": "彩愛",
      "text": "ただ、自動調理でも、最初は少し様子を見ると安心ですわ。焼きすぎると身が固くなってしまいますもの",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "お客様・男性",
      "text": "たしかに。いつも少し焼きすぎるんですよね"
    },
    {
      "speaker": "彩愛",
      "text": "少し控えめにして、様子を見ながら調整するのもよろしいかと思います",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "お客様・男性",
      "text": "分かりやすいですね。ありがとうございます"
    },
    {
      "speaker": "",
      "text": "説明は短かったが、お客様は納得した様子で機種を見比べ始めた。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、必要以上に詳しく語らない。でも、言葉の端に実感がある。"
    },
    {
      "speaker": "",
      "text": "魚を焼くという暮らしの感覚を知っているからだろう。"
    },
    {
      "speaker": "",
      "text": "お客様が売場を離れた後、緋奈が小声で言った。"
    },
    {
      "speaker": "緋奈",
      "text": "彩愛さん、やっぱり説明うまいですね",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "ありがとうございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "川魚経験が活きましたね！",
      "storySprites": [
        {
          "id": "aa",
          "src": "images/assets/char/a10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "彩愛",
      "text": "その言い方ですと、少し野性味が強く聞こえますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも、経験が接客につながってるのは本当だと思います"
    },
    {
      "speaker": "彩愛",
      "text": "店長まで",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日もちゃんと届いてました"
    },
    {
      "speaker": "彩愛",
      "text": "……そう言われると、悪い気はいたしません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "緋奈",
      "text": "彩愛さん、最近ちょっと褒められ慣れてきました？",
