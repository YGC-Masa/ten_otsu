  "steps": [
    {
      "speaker": "",
      "text": "――ひだまりストア・閉店後――",
      "bg": "images/assets/bg/battle_store_lv1.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "",
      "text": "――閉店後のひだまりストア。"
    },
    {
      "speaker": "",
      "text": "店内の照明は落とされ、外には夜の空気が広がっていた。"
    },
    {
      "speaker": "",
      "text": "今日はいつもより少しだけ、店先の空が気になる夜だった。"
    },
    {
      "speaker": "",
      "text": "――夜空は店先で、小さなバッグを両手で持っている。"
    },
    {
      "speaker": "",
      "text": "中には手袋、マフラー、携帯用カイロ、水筒。"
    },
    {
      "speaker": "",
      "text": "何度も確認したものばかりだった。"
    },
    {
      "speaker": "美空",
      "text": "夜空、準備は大丈夫？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "大丈夫って言うと、美空が怒る。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "怒らないよ。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "怒るより先に、ぎゅってしたがる。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "それはあるかも。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "認めないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "ふふっ。\nじゃあ、準備は？",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……した。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "うん。\nちゃんとできました。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "子ども扱いしないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "大事な妹扱いです。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "……ずるい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "夜空、寒くないか？"
    },
    {
      "speaker": "夜空",
      "text": "まだ平気。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "まだ？"
    },
    {
      "speaker": "夜空",
      "text": "寒くなったら、寒いって言う。\n怖くなったら、怖いって言う。\n……たぶん。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "たぶんでも、言えたらえらいよ。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "褒めないで。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "褒めました。",
      "storySprites": [
        {
          "id": "ah",
          "src": "images/assets/char/h10202.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "夜空",
      "text": "褒めないでって言った。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "じゃあ、無理はしないで行こう。"
    },
    {
      "speaker": "夜空",
      "text": "それも言われると思った。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "先回りされたな。"
    },
    {
      "speaker": "夜空",
      "text": "でも、今日は言われてもいい。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そっか。"
