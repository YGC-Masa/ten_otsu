      "text": "すごく嬉しい"
    },
    {
      "speaker": "夜空",
      "text": "大げさ"
    },
    {
      "speaker": "美空",
      "text": "大げさじゃないよ"
    },
    {
      "speaker": "夜空",
      "text": "ココアの時も言ってた"
    },
    {
      "speaker": "美空",
      "text": "だって"
    },
    {
      "speaker": "美空",
      "text": "嬉しかったから"
    },
    {
      "speaker": "夜空",
      "text": "……"
    },
    {
      "speaker": "美空",
      "text": "今日も、嬉しい"
    },
    {
      "speaker": "",
      "text": "夜空は少しだけ目をそらした。"
    },
    {
      "speaker": "夜空",
      "text": "変なの"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "でも、嬉しい"
    },
    {
      "speaker": "夜空",
      "text": "それに"
    },
    {
      "speaker": "美空",
      "text": "うん？"
    },
    {
      "speaker": "夜空",
      "text": "美空と同じだからって"
    },
    {
      "speaker": "夜空",
      "text": "別に、嫌じゃないし"
    },
    {
      "speaker": "美空",
      "text": "……夜空"
    },
    {
      "speaker": "夜空",
      "text": "変に感動しないで"
    },
    {
      "speaker": "美空",
      "text": "してないよ"
    },
    {
      "speaker": "夜空",
      "text": "してる顔"
    },
    {
      "speaker": "美空",
      "text": "してるかも"
    },
    {
      "speaker": "夜空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "夜空は小さくため息をついた。"
    },
    {
      "speaker": "",
      "text": "けれど、歩く速度は少しだけ美空に合わせている。"
    },
    {
      "speaker": "",
      "text": "美空は、それに気づいて、また少し嬉しくなった。"
    },
    {
      "speaker": "",
      "text": "自販機の前に着く。"
    },
    {
      "speaker": "",
      "text": "美空は立ち止まった。"
    },
    {
      "speaker": "美空",
      "text": "じゃあ"
    },
    {
      "speaker": "美空",
      "text": "今度また、ココア飲む？"
    },
    {
      "speaker": "夜空",
      "text": "……また？"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "今度は最初から"
    },
    {
      "speaker": "美空",
      "text": "一緒のにする？って聞く"
    },
    {
      "speaker": "夜空",
      "text": "……"
    },
    {
      "speaker": "美空",
      "text": "だめ？"
    },
    {
      "speaker": "夜空",
      "text": "別に"
    },
    {
      "speaker": "美空",
      "text": "別に？"
    },
    {
      "speaker": "夜空",
      "text": "飲まないとは言ってない"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "じゃあ、飲むんだ"
    },
    {
      "speaker": "夜空",
      "text": "勝手に決めないで"
    },
    {
      "speaker": "美空",
      "text": "でも、飲まないとは言ってない"
    },
    {
      "speaker": "夜空",
      "text": "それ、ぼくの言い方"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "借りました"
    },
    {
      "speaker": "夜空",
      "text": "返して"
    },
    {
      "speaker": "美空",
      "text": "返すものなの？"
    },
    {
      "speaker": "夜空",
      "text": "知らない"
    },
    {
      "speaker": "",
      "text": "美空は笑った。"
    },
    {
      "speaker": "",
      "text": "夜空も、ほんの少しだけ口元を緩めた。"
    },
    {
      "speaker": "",
      "text": "美空は自販機のボタンを見る。"
    },
    {
      "speaker": "",
      "text": "ココアはない。"
    },
    {
      "speaker": "",
      "text": "缶コーヒー。"
    },
    {
      "speaker": "",
      "text": "お茶。"
    },
    {
      "speaker": "",
      "text": "炭酸。"
    },
    {
      "speaker": "",
      "text": "ミルクティー。"
    },
    {
      "speaker": "",
      "text": "いろいろ並んでいる。"
    },
    {
      "speaker": "美空",
      "text": "今日は"
    },
    {
      "speaker": "美空",
      "text": "何にする？"
    },
    {
      "speaker": "夜空",
      "text": "美空が先"
    },
    {
      "speaker": "美空",
      "text": "私が？"
    },
    {
      "speaker": "夜空",
      "text": "うん"
    },
    {
      "speaker": "夜空",
      "text": "聞きたいんでしょ"
    },
    {
      "speaker": "夜空",
      "text": "自分が選びたいもの"
    },
    {
      "speaker": "",
      "text": "美空は少し驚いた。"
    },
    {
      "speaker": "",
      "text": "夜空は、何でもないように言う。"
    },
    {
      "speaker": "",
      "text": "けれど、それはきっと、夜空なりに美空を見ている言葉だった。"
    },
    {
      "speaker": "美空",
      "text": "じゃあ"
    },
    {
      "speaker": "美空",
      "text": "今日は、ミルクティー"
    },
    {
      "speaker": "夜空",
      "text": "甘そう"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "甘いのがいい気分"
    },
    {
      "speaker": "夜空",
      "text": "そう"
    },
    {
      "speaker": "美空",
      "text": "夜空は？"
    },
    {
      "speaker": "夜空",
      "text": "……同じのでいい"
    },
    {
      "speaker": "美空",
      "text": "え"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "美空",
      "text": "同じのでいいの？"
    },
    {
      "speaker": "夜空",
      "text": "美空が選んだの"
    },
    {
      "speaker": "夜空",
      "text": "たまには飲んでみる"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "美空",
      "text": "嬉しい"
    },
    {
      "speaker": "夜空",
      "text": "また"
    },
    {
      "speaker": "美空",
      "text": "何回でも言うよ"
    },
    {
      "speaker": "夜空",
      "text": "うるさい"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "",
      "text": "美空はミルクティーを二本買った。"
    },
    {
      "speaker": "",
      "text": "一本を夜空に渡す。"
    },
    {
      "speaker": "",
      "text": "夜空は受け取り、缶を見た。"
    },
    {
      "speaker": "夜空",
      "text": "甘そう"
    },
    {
      "speaker": "美空",
      "text": "甘いと思う"
    },
    {
      "speaker": "夜空",
      "text": "まあ"
    },
    {
      "speaker": "夜空",
      "text": "今日はいい"
    },
    {
      "speaker": "美空",
      "text": "今日はいいんだ"
    },
    {
      "speaker": "夜空",
      "text": "うん"
    },
    {
      "speaker": "",
      "text": "二人は自販機の近くの低い柵に並んで座った。"
    },
    {
      "speaker": "",
      "text": "夜空が缶を開ける。"
    },
    {
      "speaker": "",
      "text": "美空も同じように開ける。"
    },
    {
      "speaker": "",
      "text": "同じ音が、夜の通りに小さく響いた。"
    },
    {
      "speaker": "美空",
      "text": "同じ音"
    },
    {
      "speaker": "夜空",
      "text": "缶だから"
    },
    {
      "speaker": "美空",
      "text": "そうだけど"
    },
    {
      "speaker": "美空",
      "text": "なんか、いいなって"
    },
    {
      "speaker": "夜空",
      "text": "美空って"
    },
    {
      "speaker": "夜空",
      "text": "たまに何でも嬉しがる"
    },
    {
      "speaker": "美空",
      "text": "夜空と一緒だと"
    },
    {
      "speaker": "美空",
      "text": "嬉しいことが増えるんだよ"
    },
    {
      "speaker": "夜空",
      "text": "……"
    },
    {
      "speaker": "",
      "text": "夜空は缶に口をつけた。"
    },
    {
      "speaker": "",
      "text": "一口飲んで、少しだけ眉を寄せる。"
    },
    {
      "speaker": "美空",
      "text": "どう？"
    },
    {
      "speaker": "夜空",
      "text": "甘い"
    },
    {
      "speaker": "美空",
      "text": "だよね"
    },
    {
      "speaker": "夜空",
      "text": "でも"
    },
    {
      "speaker": "美空",
      "text": "でも？"
    },
    {
      "speaker": "夜空",
      "text": "悪くない"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "夜空の悪くない、好き"
    },
    {
      "speaker": "夜空",
      "text": "好きとか言わないで"
    },
    {
      "speaker": "美空",
      "text": "え、言い方の話だよ？"
    },
    {
      "speaker": "夜空",
      "text": "分かってる"
    },
    {
      "speaker": "美空",
      "text": "分かってて照れた？"
    },
    {
      "speaker": "夜空",
      "text": "照れてない"
    },
    {
      "speaker": "美空",
      "text": "そっか"
    },
    {
      "speaker": "美空",
      "text": "照れてないか"
    },
    {
      "speaker": "夜空",
      "text": "その顔やめて"
    },
    {
      "speaker": "",
      "text": "美空は笑う。"
    },
    {
      "speaker": "",
      "text": "その笑い声は、夜の道に柔らかく溶けた。"
    },
    {
      "speaker": "",
      "text": "しばらく、二人は同じミルクティーを飲んだ。"
    },
    {
      "speaker": "",
      "text": "何を話すわけでもない。"
    },
    {
      "speaker": "",
      "text": "けれど、沈黙は苦しくなかった。"
    },
    {
      "speaker": "",
      "text": "美空は缶を両手で包む。"
    },
    {
      "speaker": "",
      "text": "少し温かい。"
    },
    {
      "speaker": "",
      "text": "ココアほどではないけれど、じんわりと指先に熱が移る。"
    },
    {
      "speaker": "美空",
      "text": "夜空"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "美空",
      "text": "同じものを選んでも"
    },
    {
      "speaker": "美空",
      "text": "夜空は夜空だね"
    },
    {
      "speaker": "夜空",
      "text": "当たり前でしょ"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "私は私だね"
    },
    {
      "speaker": "夜空",
      "text": "当たり前"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "美空",
      "text": "当たり前なんだ"
    },
    {
      "speaker": "夜空",
      "text": "何が面白いの"
    },
    {
      "speaker": "美空",
      "text": "嬉しいなって"
    },
    {
      "speaker": "夜空",
      "text": "変なの"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "でも、嬉しい"
    },
    {
      "speaker": "",
      "text": "夜空はまた、少しだけ息を吐いた。"
    },
    {
      "speaker": "",
      "text": "でも、今度は呆れたというより、少しだけ安心したような息だった。"
    },
    {
      "speaker": "夜空",
      "text": "美空"
    },
    {
      "speaker": "美空",
      "text": "なに？"
    },
    {
      "speaker": "夜空",
      "text": "ぼくが違うのを選んでも"
    },
    {
      "speaker": "夜空",
      "text": "別に、遠くなるわけじゃないから"
    },
    {
      "speaker": "美空",
      "text": "……"
    },
    {
      "speaker": "夜空",
      "text": "同じのを選んでも"
    },
    {
      "speaker": "夜空",
      "text": "美空になるわけじゃないし"
    },
    {
      "speaker": "夜空",
      "text": "美空がぼくになるわけでもない"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "夜空",
      "text": "だから"
    },
    {
      "speaker": "夜空",
      "text": "その時、選びたい方でいい"
    },
    {
      "speaker": "美空",
      "text": "……うん"
    },
    {
      "speaker": "美空",
      "text": "そうだね"
    },
    {
      "speaker": "夜空",
      "text": "分かった？"
    },
    {
      "speaker": "美空",
      "text": "分かった"
    },
    {
      "speaker": "美空",
      "text": "たぶん"
    },
    {
      "speaker": "夜空",
      "text": "たぶん？"
    },
    {
      "speaker": "美空",
      "text": "夜空がさっき、たぶんでいいって言ったから"
    },
    {
      "speaker": "夜空",
      "text": "そこ拾わなくていい"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "",
      "text": "二人は缶を持ったまま、少しだけ夜空を見上げた。"
    },
    {
      "speaker": "",
      "text": "空は黒い。"
    },
    {
      "speaker": "",
      "text": "星は少しだけ見える。"
    },
    {
      "speaker": "",
      "text": "美空は思った。"
    },
    {
      "speaker": "",
      "text": "同じものを選んでも、夜空は夜空で、私は私。"
    },
    {
      "speaker": "",
      "text": "違うものを選んでも、夜空は遠くならない。"
    },
    {
      "speaker": "",
      "text": "きっと、これからも迷うことはある。"
    },
    {
      "speaker": "",
      "text": "でも、その時は聞けばいい。"
    },
    {
      "speaker": "",
      "text": "同じのにする？"
    },
    {
      "speaker": "",
      "text": "違うのにする？"
    },
    {
      "speaker": "",
      "text": "夜空はきっと、そっけない顔で答える。"
    },
    {
      "speaker": "",
      "text": "でも、その答えを聞けることが。"
    },
    {
      "speaker": "",
      "text": "今は、少しだけ嬉しかった。"
    },
    {
      "speaker": "美空",
      "text": "夜空"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "美空",
      "text": "また、聞くね"
    },
    {
      "speaker": "夜空",
      "text": "何を"
    },
    {
      "speaker": "美空",
      "text": "同じのにする？って"
    },
    {
      "speaker": "夜空",
      "text": "……好きにすれば"
    },
    {
      "speaker": "美空",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "好きにする"
    },
    {
      "speaker": "夜空",
      "text": "素直"
    },
    {
      "speaker": "美空",
      "text": "今日はね"
    },
    {
      "speaker": "夜空",
      "text": "いつも素直でいいのに"
    },
    {
      "speaker": "美空",
      "text": "夜空もね"
    },
    {
      "speaker": "夜空",
      "text": "ぼくは素直"
    },
    {
      "speaker": "美空",
      "text": "えっ"
    },
    {
      "speaker": "夜空",
      "text": "何"
    },
    {
      "speaker": "美空",
      "text": "ううん"
    },
    {
      "speaker": "美空",
      "text": "そうだね"
    },
    {
      "speaker": "美空",
      "text": "夜空は素直だね"
    },
    {
      "speaker": "夜空",
      "text": "絶対思ってない"
    },
    {
      "speaker": "美空",
      "text": "ふふ"
    },
    {
      "speaker": "夜空",
      "text": "笑わないで"
    },
    {
      "speaker": "",
      "text": "二人は並んで歩き出す。"
    },
    {
      "speaker": "",
      "text": "同じミルクティーを持って。"
    },
    {
      "speaker": "",
      "text": "同じ道を、少し違う歩幅で。"
    },
    {
      "speaker": "",
      "text": "でも、ちゃんと隣に並んで。"
    },
    {
      "speaker": "",
      "text": "美空は夜空の横顔を見て、静かに笑った。"
    },
    {
      "speaker": "",
      "text": "同じでも、同じじゃない。"
    },
    {
      "speaker": "",
      "text": "違っても、遠くない。"
    },
    {
      "speaker": "",
      "text": "そのことを、今日、少しだけ分かった気がした。"
    }
  ]
}
