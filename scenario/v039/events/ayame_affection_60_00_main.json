        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ照れたように笑った。"
    },
    {
      "speaker": "",
      "text": "その表情は、いつもの完璧な微笑みではなかった。"
    },
    {
      "speaker": "",
      "text": "少し困っていて、少し嬉しそうで。\n少しだけ素直だった。"
    },
    {
      "speaker": "彩愛",
      "text": "でも",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "今日は、それでよいです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……分かりました"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、グラスに残ったアンバーエールを見つめる。"
