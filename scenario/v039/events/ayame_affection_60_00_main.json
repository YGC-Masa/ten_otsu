    {
      "speaker": "彩愛",
      "text": "弱いところを見せてしまうからです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "俺は、見せてもらえて嬉しいです"
