    {
      "speaker": "彩愛",
      "text": "そういうところですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ頬を赤くした。"
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "謝らないでくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "そこは、謝らないところです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "分かりました"
    },
    {
      "speaker": "彩愛",
      "text": "本当に？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "たぶん"
    },
    {
      "speaker": "彩愛",
      "text": "そこは自信を持ってくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "また、いつものやり取りになる。"
    },
    {
      "speaker": "",
      "text": "けれど今日は、それが少しだけ心地よかった。"
    },
    {
      "speaker": "彩愛",
      "text": "困った方ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "また困らせましたか"
    },
    {
      "speaker": "彩愛",
      "text": "ええ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、ほんの少しだけ目を伏せる。"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしを、こんなに普通の女にしてしまうなんて",
