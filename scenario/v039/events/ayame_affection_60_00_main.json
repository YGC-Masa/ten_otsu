  ],
  "nextHint": "次の彩愛親愛ストーリーへ。",
  "renderPolicy": {
    "spritePosition": "logical_split_n_plus_1",
    "eventCgLayer": "frontOfCharacters"
  },
  "steps": [
    {
      "speaker": "",
      "text": "閉店後。",
      "bg": "images/assets/bg/bg_akari_dori_night.png",
      "bgMode": "forceReplace",
      "forceBackgroundReplace": true,
      "clearStorySprites": true
    },
    {
      "speaker": "",
      "text": "店を出たあと、俺と彩愛さんは駅前から少し外れた通りを歩いていた。"
    },
    {
      "speaker": "",
      "text": "表通りの賑やかさから一本入ると、人通りは少し落ち着く。\n灯りの少ない路地に、小さな看板が出ていた。"
    },
    {
      "speaker": "",
      "text": "BEER BAR"
    },
    {
      "speaker": "",
      "text": "木目の扉。\n真鍮色の小さなランプ。\nガラス越しに見える、カウンター奥のタップ。"
    },
    {
      "speaker": "",
      "text": "以前寄った店より、少しだけ大人びた雰囲気のビールバーだった。"
    },
    {
      "speaker": "彩愛",
      "text": "……良いお店ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんが好きそうかなと思って"
    },
    {
      "speaker": "彩愛",
      "text": "また、そういうことを",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "外しました？"
    },
    {
      "speaker": "彩愛",
      "text": "いいえ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、看板を見上げて少しだけ微笑む。"
    },
    {
      "speaker": "彩愛",
      "text": "当たりですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それならよかったです"
    },
    {
      "speaker": "彩愛",
      "text": "けれど、油断なりませんわね。店長は",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日はまだ何もしてないつもりです"
    },
    {
      "speaker": "彩愛",
      "text": "そういうところですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少し楽しそうにそう言った。"
    },
    {
      "speaker": "",
      "text": "店内に入ると、控えめな音楽と、麦芽の香りがふわりと漂ってきた。"
    },
    {
      "speaker": "",
      "text": "カウンターの奥には、いくつものタップが並んでいる。\n黒板には、その日つながっているビールの名前が手書きで並んでいた。"
    },
    {
      "speaker": "",
      "text": "ラガー。\nペールエール。\nアンバーエール。\nスタウト。\nベルジャンホワイト。\nフルーツビール。"
    },
    {
      "speaker": "",
      "text": "派手な店ではない。\nけれど、静かにビールを楽しむにはちょうどいい。"
    },
    {
      "speaker": "",
      "text": "俺たちはカウンター席に並んで座った。"
    },
    {
      "speaker": "店員",
      "text": "いらっしゃいませ。メニューはこちらです"
    },
    {
      "speaker": "彩愛",
      "text": "ありがとうございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、メニューを静かに開いた。"
    },
    {
      "speaker": "",
      "text": "その横顔はいつものように上品だったが、どこか少し考え込んでいるようにも見えた。"
    },
    {
      "speaker": "店長",
      "text": "今日は、何にします？"
    },
    {
      "speaker": "彩愛",
      "text": "そうですわね……",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ迷ってから黒板を見た。"
    },
    {
      "speaker": "彩愛",
      "text": "今日は、アンバーエールにいたします",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "アンバーエール？"
    },
    {
      "speaker": "彩愛",
      "text": "琥珀色のエールですわ。ラガーよりも麦芽の風味をゆっくり楽しめます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "へえ"
    },
    {
      "speaker": "彩愛",
      "text": "苦味だけでなく、少し香ばしく、カラメルのような甘みを感じるものもございますの",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さん、本当に詳しいですね"
    },
    {
      "speaker": "彩愛",
      "text": "嗜む程度ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "その言葉、もう完全に信用できなくなってます"
    },
    {
      "speaker": "彩愛",
      "text": "まあ。失礼ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "褒めてます"
    },
    {
      "speaker": "彩愛",
      "text": "その褒め方は、少し雑ですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんはそう言いながらも、少しだけ笑っている。"
    },
    {
      "speaker": "店長",
      "text": "食べ物はどうしましょう"
    },
    {
      "speaker": "彩愛",
      "text": "チーズの盛り合わせがよろしいかと",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "アンバーエールに合うんですか？"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。チーズの塩気やコクと、アンバーエールの香ばしさは相性がよいですわ。重すぎませんし、ゆっくりお話しするにはちょうどよいかと",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "ゆっくり話す"
    },
    {
      "speaker": "彩愛",
      "text": "……ええ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "そこで、彩愛さんは少しだけ言葉を止めた。"
    },
    {
      "speaker": "店長",
      "text": "彩愛さん？"
    },
    {
      "speaker": "彩愛",
      "text": "今日は……少しだけ、静かに飲みたい気分でしたので",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "そうだったんですね"
    },
    {
      "speaker": "彩愛",
      "text": "はい",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんはメニューを閉じる。"
    },
    {
      "speaker": "彩愛",
      "text": "それから、少しだけ……お酒の力を借りたい話がございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "無理に話さなくても大丈夫ですよ"
    },
    {
      "speaker": "彩愛",
      "text": "分かっております",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、穏やかに微笑んだ。"
    },
    {
      "speaker": "",
      "text": "けれど、その笑顔は少しだけ慎重だった。"
    },
    {
      "speaker": "彩愛",
      "text": "けれど、素面のままですと、きっとまた上手に整えてしまいますから",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "整える？"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。話しやすい形にして、聞かれて困らない言葉だけを選んで、きちんとした話にしてしまいます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さんらしいですね"
    },
    {
      "speaker": "彩愛",
      "text": "また“らしい”ですか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "いいえ。今日は、その通りですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "店員がアンバーエールを二つ運んできた。"
    },
    {
      "speaker": "",
      "text": "琥珀色のグラス。\nやわらかい泡。\n照明を受けて、ビールの色が少し赤みを帯びて見える。"
    },
    {
      "speaker": "店員",
      "text": "チーズ盛り合わせは、少々お待ちください"
    },
    {
      "speaker": "彩愛",
      "text": "ありがとうございます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "店員が離れると、彩愛さんはグラスを静かに持ち上げた。"
    },
    {
      "speaker": "彩愛",
      "text": "今日も、お疲れ様でした",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "お疲れ様でした"
    },
    {
      "speaker": "",
      "text": "グラスを軽く合わせる。"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、アンバーエールを一口飲んだ。"
    },
    {
      "speaker": "彩愛",
      "text": "……香ばしくて、美味しいですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "表情が柔らかくなりました"
    },
    {
      "speaker": "彩愛",
      "text": "実況しないでくださいませ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "……ですが、美味しいのは本当です",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ頬を緩めた。"
    },
    {
      "speaker": "",
      "text": "しばらくして、チーズの盛り合わせも届いた。"
    },
    {
      "speaker": "",
      "text": "白カビチーズ。\nハードタイプのチーズ。\nスモークチーズ。\n少しだけ添えられたナッツとドライフルーツ。"
    },
    {
      "speaker": "彩愛",
      "text": "良い組み合わせですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "今日は、前より少し大人っぽい感じですね"
    },
    {
      "speaker": "彩愛",
      "text": "唐揚げと枝豆も好きですわよ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "知ってます"
    },
    {
      "speaker": "彩愛",
      "text": "ふふ。そうでしたわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、チーズを一切れ取り、小さく口に運んだ。"
    },
    {
      "speaker": "彩愛",
      "text": "……ええ。よく合います",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "アンバーエールと？"
    },
    {
      "speaker": "彩愛",
      "text": "はい。チーズの塩気とコクが、ビールの香ばしさを引き立てますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "なるほど"
    },
    {
      "speaker": "彩愛",
      "text": "ただ、今日は味の説明ばかりをしたいわけではありません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "",
      "text": "彩愛さんは、グラスを両手で包むように持った。"
    },
    {
      "speaker": "",
      "text": "泡の少し消えた水面を見つめる。"
    },
    {
      "speaker": "彩愛",
      "text": "店長",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "わたくし、最近少し困っております",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "困っている？"
    },
    {
      "speaker": "彩愛",
      "text": "ええ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、静かに息を吸った。"
    },
    {
      "speaker": "彩愛",
      "text": "店長の前だと、余計なことまで話してしまいます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "余計なこと、ですか"
    },
    {
      "speaker": "彩愛",
      "text": "はい。本来なら、胸の内にしまっておくようなことです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "例えば？"
    },
    {
      "speaker": "彩愛",
      "text": "親戚の言葉に疲れていること",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "結婚の話に焦っていること",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "誰かと暮らすことが、少し怖いこと",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……はい"
    },
    {
      "speaker": "彩愛",
      "text": "普通のわたくしでよいのか、不安になること",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、一つずつ、丁寧に言葉を置いていった。"
    },
    {
      "speaker": "",
      "text": "それは、これまで少しずつ聞いてきた本音だった。"
    },
    {
      "speaker": "",
      "text": "けれど、こうして並べられると、彩愛さんがどれだけ自分の中で抱えていたのかが分かる。"
    },
    {
      "speaker": "彩愛",
      "text": "……こうして並べると、わたくし、ずいぶん普通の女ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "普通でいいと思います"
    },
    {
      "speaker": "彩愛",
      "text": "簡単におっしゃいますわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい。簡単でいいと思っています"
    },
    {
      "speaker": "彩愛",
      "text": "店長は、時々本当に簡単にしてしまいます",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しくしすぎるよりは、いいかなと"
    },
    {
      "speaker": "彩愛",
      "text": "ふふ。困った方ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、アンバーエールを少しだけ飲んだ。"
    },
    {
      "speaker": "彩愛",
      "text": "本音を言うというのは、難しいですわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "難しいですか"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。言ってしまった瞬間、もう戻せない気がしますもの",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "戻せない"
    },
    {
      "speaker": "彩愛",
      "text": "はい。きちんとしているつもりでも、弱いところを見せてしまう。余裕のあるふりをしていても、余裕がないことを知られてしまう",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……"
    },
    {
      "speaker": "彩愛",
      "text": "そうすると、相手の中の“わたくし”が変わってしまう気がするのです",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "彩愛さん"
    },
    {
      "speaker": "彩愛",
      "text": "はい",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "俺の中の彩愛さんは、変わってますよ"
    },
    {
      "speaker": "彩愛",
      "text": "……え？",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "最初は、上品で、きちんとしていて、何でもできそうな人だと思ってました"
    },
    {
      "speaker": "彩愛",
      "text": "……",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "でも今は、親戚の言葉に疲れることもある人で、結婚の話に焦ることもある人で、誰かと暮らすことを怖いと思う人で"
    },
    {
      "speaker": "彩愛",
      "text": "店長",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "唐揚げと枝豆を美味しそうに食べる人で、ビールの話になると少し楽しそうになる人です"
    },
    {
      "speaker": "彩愛",
      "text": "……そこまで言いますか",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "意地悪ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "すみません"
    },
    {
      "speaker": "彩愛",
      "text": "でも",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ目を伏せた。"
    },
    {
      "speaker": "彩愛",
      "text": "嫌ではありません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "それならよかったです"
    },
    {
      "speaker": "彩愛",
      "text": "お礼を言われると困りますわ",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "言ってません"
    },
    {
      "speaker": "彩愛",
      "text": "あら。本当ですわね",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "",
      "text": "彩愛さんは、少しだけ笑った。"
    },
    {
      "speaker": "",
      "text": "その笑顔は、いつもの完璧な微笑みではない。"
    },
    {
      "speaker": "",
      "text": "少し照れていて、少し困っていて、少し素直だった。"
    },
    {
      "speaker": "彩愛",
      "text": "わたくしは、もっと完璧な人間でいたかったのかもしれません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "完璧な人間"
    },
    {
      "speaker": "彩愛",
      "text": "ええ。家事ができて、気配りができて、誰に紹介しても恥ずかしくなくて、弱音を言わずに、いつも上品で",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "でも、実際にはそうではありません",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "……"
    },
    {
      "speaker": "彩愛",
      "text": "親戚の言葉に疲れますし、結婚の話に焦りますし、誰かと暮らすことが怖くなりますし",
      "storySprites": [
        {
          "id": "ak",
          "src": "images/assets/char/k10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "店長",
      "text": "はい"
    },
    {
      "speaker": "彩愛",
      "text": "ビールとチーズで、少し気持ちがほどけます",
