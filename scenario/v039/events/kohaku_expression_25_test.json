          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［10/25 照れ］べ、別に怖くねえし。ただ……旦那の袖、ちょっと借りるだけだ。",
      "expressionId": "10",
      "expressionLabel": "照れ",
      "storySprites": [
        {
