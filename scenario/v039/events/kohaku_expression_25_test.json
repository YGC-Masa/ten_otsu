      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［17/25 伏し目／余韻］このイヤホン、花の香りがするな。昼に花売り場へ寄った時のままだ。",
      "expressionId": "17",
      "expressionLabel": "伏し目／余韻",
      "storySprites": [
        {
