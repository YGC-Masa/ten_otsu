          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［20/25 無言の圧／見透かす］……旦那。なんでそのポケットから、もう片方のケースが出てくるんだ？",
      "expressionId": "20",
      "expressionLabel": "無言の圧／見透かす",
      "storySprites": [
        {
          "id": "ae",
          "src": "images/assets/char/ae_kohaku/standing/ae_kohaku_expression_20_silent_pressure.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［21/25 黒い微笑み／不穏］まさかオレを怖がらせるために仕込んだ、とか言わねえよな……？",
      "expressionId": "21",
