          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［06/25 悲しみ］限定モデルなのに……なくしたままじゃ、明日の試聴会ができねえ。",
      "expressionId": "06",
      "expressionLabel": "悲しみ",
      "storySprites": [
        {
          "id": "ae",
          "src": "images/assets/char/ae_kohaku/standing/ae_kohaku_expression_06_sadness.webp",
