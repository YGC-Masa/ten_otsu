      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［18/25 拗ね／ぷいっ］旦那だけ先に明るい方へ行くなよ。……置いてったら怒るからな。",
      "expressionId": "18",
      "expressionLabel": "拗ね／ぷいっ",
      "storySprites": [
