    {
      "speaker": "春日原 琥珀",
      "text": "［23/25 見惚れ／ときめき前］ケースの中に、小さな押し花……オレが好きだって、覚えてたのか。",
      "expressionId": "23",
      "expressionLabel": "見惚れ／ときめき前",
      "storySprites": [
        {
          "id": "ae",
