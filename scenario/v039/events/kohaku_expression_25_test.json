          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［19/25 泣き笑い］あった！　イヤホンも無事だ……よかったぁ。ほんと、よかった。",
      "expressionId": "19",
      "expressionLabel": "泣き笑い",
      "storySprites": [
        {
