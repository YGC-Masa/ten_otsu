          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［07/25 心配／不安］棚の奥から、カチ……カチ……って音がする。まさか、誰かいるのか？",
      "expressionId": "07",
      "expressionLabel": "心配／不安",
      "storySprites": [
        {
          "id": "ae",
          "src": "images/assets/char/ae_kohaku/standing/ae_kohaku_expression_07_worry.webp",
          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［08/25 動揺］い、今、箱が勝手に動かなかったか！？　旦那、見たよな！？",
      "expressionId": "08",
      "expressionLabel": "動揺",
      "storySprites": [
        {
