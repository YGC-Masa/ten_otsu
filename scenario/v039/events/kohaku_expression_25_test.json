          "side": "center",
          "left": "50%",
          "zIndex": 2500,
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "［13/25 いたずらな笑顔・舌出しウィンク］幽霊だったら、旦那を置いて先に逃げるかもな。……冗談だって。",
      "expressionId": "13",
