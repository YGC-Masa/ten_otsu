    {"bg":"images/assets/bgev/bg_office_hidamari.png","speaker":"","text":"【特別シナリオ】2026年9月17日。美空から、須藤さんへ。","bgMode":"forceReplace","clearStorySprites":true,"forceBackgroundReplace":true},
