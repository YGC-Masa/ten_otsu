    {
      "speaker": "春日原 琥珀",
      "text": "佐藤さん、はじめまして。春日原琥珀です！",
      "storySprites": [{"id":"ae","src":"images/assets/char/ae_kohaku/standing/ae_kohaku_expression_03_smile.webp","side":"center","left":"50%","zIndex":2500,"opacity":1}]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "今日は2026年9月16日。店長から佐藤さんのことを聞きました。"
    },
    {
      "speaker": "春日原 琥珀",
      "text": "オレは『ひだまりストア』で働いてて、スポーツが大好き。家電だとオーディオやイヤホンが得意分野なんだ。だからイヤホンを売ってるって聞いて、なんか勝手に親近感わいてる！",
      "storySprites": [{"id":"ae","src":"images/assets/char/ae_kohaku/standing/ae_kohaku_expression_11_expectation.webp","side":"center","left":"50%","zIndex":2500,"opacity":1}]
    },
    {
      "speaker": "春日原 琥珀",
      "text": "それに、ほかならぬ店長の頼みだからな。"
    },
    {
      "speaker": "春日原 琥珀",
      "text": "佐藤さんのイヤホン、いつでもひだまりストアでオレが紹介する。任せろ！",
