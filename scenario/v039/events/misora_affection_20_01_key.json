          "id": "ai",
          "src": "images/assets/char/i10101.webp",
          "opacity": 1
        }
      ]
    },
    {
      "speaker": "美空",
      "text": "は、はい！"
    },
    {
      "speaker": "",
      "text": "思ったより大きな声が出てしまった。"
    },
    {
      "speaker": "",
      "text": "店長が少し笑う。"
    },
    {
      "speaker": "",
      "text": "美空は店長を軽く睨む。"
    },
    {
      "speaker": "",
      "text": "夜空が扉の向こうから顔を出した。"
    },
    {
      "speaker": "夜空",
      "text": "レジ横の資料"
    },
    {
      "speaker": "夜空",
      "text": "どこ置いたか知らない？"
