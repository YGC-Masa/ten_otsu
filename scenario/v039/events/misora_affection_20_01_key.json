    {
      "speaker": "美空",
      "text": "私"
    },
    {
      "speaker": "美空",
      "text": "ちゃんと聞きたいです"
    },
    {
      "speaker": "美空",
      "text": "夜空が、今もココア好きかどうか"
    },
    {
      "speaker": "美空",
      "text": "私と同じものを選んでもいいかどうか"
