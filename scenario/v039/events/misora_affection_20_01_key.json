    },
    {
      "speaker": "店長",
      "text": "美空がちゃんと聞きたいと思ってるなら"
    },
    {
      "speaker": "店長",
      "text": "それでいいだろ"
    },
    {
      "speaker": "美空",
      "text": "……ちゃんと聞きたい"
    },
    {
      "speaker": "店長",
      "text": "ああ"
    },
    {
      "speaker": "",
      "text": "美空は、手元のココアを見る。"
    },
    {
      "speaker": "",
      "text": "夜空に渡すために買ったココア。"
    },
    {
      "speaker": "",
      "text": "昔の思い出を確かめるためのココア。"
    },
    {
      "speaker": "",
      "text": "同じものを、もう一度選んでみるためのココア。"
