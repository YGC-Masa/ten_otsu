    {
      "speaker": "店長",
      "text": "そっか"
    },
    {
      "speaker": "美空",
      "text": "はい"
    },
    {
      "speaker": "",
      "text": "その時、バックヤードの外から夜空の声がした。"
    },
    {
      "speaker": "夜空",
      "text": "美空",
      "storySprites": [
        {
