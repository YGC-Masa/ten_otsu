    },
    {
      "speaker": "美空",
      "text": "ももちゃんは炭酸"
    },
    {
      "speaker": "美空",
      "text": "藍ちゃんはお茶"
    },
    {
      "speaker": "美空",
      "text": "彩愛さんは紅茶"
    },
    {
      "speaker": "美空",
      "text": "店長はメロンソーダ"
    },
    {
      "speaker": "店長",
      "text": "相変わらず、よく覚えてるな"
    },
    {
      "speaker": "美空",
      "text": "みんなのことですから"
    },
    {
      "speaker": "",
      "text": "美空は少し得意げに笑う。"
