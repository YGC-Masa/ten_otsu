    {
      "speaker": "夜空",
      "text": "ありがと"
    },
    {
      "speaker": "",
      "text": "夜空は戻っていった。"
    },
    {
      "speaker": "",
      "text": "扉が静かに閉まる。"
    },
    {
      "speaker": "",
      "text": "美空は、少しだけ息を吐いた。"
    },
    {
      "speaker": "店長",
      "text": "惜しかったな"
    },
    {
      "speaker": "美空",
      "text": "見てたんですか"
    },
    {
      "speaker": "店長",
      "text": "見てた"
    },
    {
      "speaker": "美空",
      "text": "店長"
    },
    {
      "speaker": "美空",
      "text": "そういうところ、少し意地悪です"
