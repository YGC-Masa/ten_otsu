    {
      "speaker": "店長",
      "text": "うん"
    },
    {
      "speaker": "美空",
      "text": "だから"
    },
    {
      "speaker": "美空",
      "text": "今日は、ここに置いておきます"
    },
    {
      "speaker": "",
      "text": "美空はロッカー横の棚に、ココアの箱をそっと置いた。"
    },
    {
      "speaker": "",
      "text": "すぐに渡せる場所。"
    },
    {
      "speaker": "",
      "text": "でも、まだ渡していない場所。"
    },
    {
      "speaker": "美空",
      "text": "明日"
    },
    {
      "speaker": "美空",
      "text": "渡せるかもしれません"
    },
    {
      "speaker": "店長",
      "text": "明日じゃなくてもいい"
