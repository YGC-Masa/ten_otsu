    {
      "speaker": "店長",
      "text": "ごめん。"
    },
    {
      "speaker": "夜空",
      "text": "謝らないで。\n今は、ぼくが言うところ。",
      "storySprites": [
        {
          "id": "ai",
          "src": "images/assets/char/i10101.webp",
