      {
        "side": "center",
        "src": "c10201.webp"
      }
    ],
    "expression": "02",
    "expressionLabel": "微笑み"
  },
  {
    "name": "翠",
    "text": "蒸しただけ、焼いただけなどのシンプルな調理が一番美味しいと思います。",
    "characters": [
      {
        "side": "center",
        "src": "c10101.webp"
      }
    ],
    "expression": "01",
    "expressionLabel": "澄まし"
  },
  {
    "name": "翠",
    "text": "好きな飲み物はコーヒー。",
    "characters": [
      {
        "side": "center",
        "src": "c10201.webp"
      }
    ],
    "expression": "02",
    "expressionLabel": "微笑み"
  },
