      {
        "side": "center",
        "src": "c10101.webp"
      }
    ],
    "expression": "01",
    "expressionLabel": "澄まし"
  },
  {
    "name": "翠",
    "text": "緑色が好きで、何かと身につける色も緑系になりがちです。",
