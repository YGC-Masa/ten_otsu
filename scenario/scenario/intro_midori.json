      {
        "side": "center",
        "src": "c10401.webp"
      }
    ],
    "expression": "04",
    "expressionLabel": "悲しみ"
  },
  {
    "name": "翠",
    "text": "映画やドラマも悲しいシーンだけじゃなく、優しいシーンでもすぐ涙が出てしまいます。",
