      {
        "side": "center",
        "src": "c10401.webp"
      }
    ],
    "expression": "04",
    "expressionLabel": "悲しみ"
  },
  {
    "name": "翠",
    "text": "私本人はそんなつもりではないんですが、皆さん困ってしまいますね。",
