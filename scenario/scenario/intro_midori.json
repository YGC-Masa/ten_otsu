      {
        "side": "center",
        "src": "c10101.webp"
      }
    ],
    "expression": "01",
    "expressionLabel": "澄まし"
  },
  {
    "name": "翠",
    "text": "体型は細めで、小柄と言われます。",
    "characters": [
      {
        "side": "center",
        "src": "c10101.webp"
      }
    ],
    "expression": "01",
    "expressionLabel": "澄まし"
  },
  {
    "name": "翠",
    "text": "服は動きやすくシンプルなものが多いですね。",
