      }
    ],
    "expression": "09",
    "expressionLabel": "得意げ"
  },
  {
    "name": "翠",
    "text": "パソコンを触る時間が長く、設定やトラブル解決は得意です。",
    "characters": [
      {
        "side": "center",
        "src": "c10902.webp"
      }
    ],
    "expression": "09",
    "expressionLabel": "得意げ"
  },
  {
    "name": "翠",
